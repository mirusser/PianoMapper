    private async Task HandleScoreUnloadedAsync()
    {
        ExitFingeringEditMode();
        await DiscardSightReadingExerciseAsync();
        await AbortPracticeAsync(updateStatus: false);
        await StopScorePlaybackAsync();
        importedScore = null;
        loadedScore = null;
        selectedScore = null;
        loadedSavedScoreId = null;
        ResetNoteReadingSession();
        selectedFirstMeasure = 0;
        selectedLastMeasure = 0;
        scoreWindowPair = null;
        secondaryCanvasScene = null;
        secondaryScoreCursorState = null;
        TimeSpan currentTime = AudioSession.IsInitialized
            ? await AudioSession.GetCurrentTimeAsync()
            : TimeSpan.Zero;
        RefreshCanvasScene(currentTime);
    }

    private Task SelectFirstMeasureAsync(ChangeEventArgs eventArgs)
    {
        if (loadedScore is not { Measures.Count: > 0 } score)
        {
            return Task.CompletedTask;
        }

        int firstMeasure = ParseClampedInteger(
            eventArgs,
            selectedFirstMeasure + 1,
            1,
            score.Measures.Count) - 1;
        return ApplySelectedMeasureRangeAsync(firstMeasure, Math.Max(firstMeasure, selectedLastMeasure));
    }

    private Task SelectLastMeasureAsync(ChangeEventArgs eventArgs)
    {
        if (loadedScore is not { Measures.Count: > 0 } score)
        {
            return Task.CompletedTask;
        }

        int lastMeasure = ParseClampedInteger(
            eventArgs,
            selectedLastMeasure + 1,
            1,
            score.Measures.Count) - 1;
        return ApplySelectedMeasureRangeAsync(Math.Min(selectedFirstMeasure, lastMeasure), lastMeasure);
    }

    private async Task ApplySelectedMeasureRangeAsync(int firstMeasure, int lastMeasure)
    {
        if (loadedScore is not { } score ||
            (firstMeasure == selectedFirstMeasure && lastMeasure == selectedLastMeasure))
        {
            return;
        }

        await AbortPracticeAsync(updateStatus: false);
        await StopScorePlaybackAsync();
        await DiscardSightReadingExerciseAsync();
        selectedFirstMeasure = firstMeasure;
        selectedLastMeasure = lastMeasure;
        selectedScoreNoteAddress = null;
        selectedScore = ScoreMeasureRange.Create(score, firstMeasure, lastMeasure);
        ResetNoteReadingSession();
        ResetScoreWindowPair();
        TimeSpan currentTime = AudioSession.IsInitialized
            ? await AudioSession.GetCurrentTimeAsync()
            : TimeSpan.Zero;
        RefreshCanvasScene(currentTime);
        audioStatus = $"Selected {SelectedMeasureRangeLabel} of {score.Title}.";
    }

    private async Task StartScorePlaybackAsync()
    {
        if (selectedScore is not { } score || !AudioSession.IsInitialized)
        {
            return;
        }

        ExitFingeringEditMode();
        await DiscardSightReadingExerciseAsync();
        await AbortPracticeAsync(updateStatus: false);
        await visualizationTicker.StopAsync();
        await playbackTicker.StopAsync();
        ResetNoteReadingSession();
        ResetScoreWindowPair();
        await ScorePlaybackSession.StartAsync(score);
        displayTimeSignature = score.TimeSignature;
        displayTempo = score.Tempo;
        RefreshCanvasScene(await AudioSession.GetCurrentTimeAsync());
        playbackTicker.Start(TickScorePlaybackAsync, CanvasRefreshInterval);
        audioStatus = $"Playing {score.Title}, {SelectedMeasureRangeLabel}.";
    }

    private async Task PlayRandomMeasureAsync()
    {
        if (!AudioSession.IsInitialized)
        {
            return;
        }

        ExitFingeringEditMode();
        await DiscardSightReadingExerciseAsync();
        await AbortPracticeAsync(updateStatus: false);
        await StopScorePlaybackAsync();
        var measure = RandomMeasureComposer.Compose(
            [TestPitch],
            displayTimeSignature,
            displayTempo,
            Random.Shared);
        TimeSpan anchor = await AudioSession.GetCurrentTimeAsync() + BrowserSchedulingLead;
        var events = BrowserRandomMeasureScheduler.CreateEvents(measure, anchor);
        await AudioSession.ScheduleScoreAsync(events);
        var timeline = new NoteTimeline();
        scheduledKeyboardNotes = events.Select((scheduledEvent, index) =>
        {
            var note = timeline.Start(measure.Events[index].Pitch, scheduledEvent.StartTime);
            timeline.Complete(note, scheduledEvent.StartTime + scheduledEvent.Duration);
            return note;
        }).ToArray();
        RefreshCanvasScene(await AudioSession.GetCurrentTimeAsync());
        EnsureVisualizationRefresh();
        audioStatus = $"Playing a random measure at {TimingLabel}.";
    }

    private async Task HandleSightReadingExerciseActionAsync(SightReadingExerciseAction action)
    {
        ArgumentNullException.ThrowIfNull(action);
        switch (action)
        {
            case SightReadingExerciseAction.SelectStaff selectStaff:
                sightReadingExerciseCoordinator.SetStaff(selectStaff.Value);
                break;
            case SightReadingExerciseAction.SelectPreset selectPreset:
                sightReadingExerciseCoordinator.SetPresetId(selectPreset.Value);
                break;
            case SightReadingExerciseAction.SelectPromptCount selectPromptCount:
                sightReadingExerciseCoordinator.SetPromptCountOption(selectPromptCount.Value);
                break;
            case SightReadingExerciseAction.SelectMotion selectMotion:
                sightReadingExerciseCoordinator.SetMotion(selectMotion.Value);
                break;
            case SightReadingExerciseAction.SelectIntervalSteps selectIntervalSteps:
                sightReadingExerciseCoordinator.SetIntervalSteps(selectIntervalSteps.Value);
                break;
            case SightReadingExerciseAction.SelectGrandStaff selectGrandStaff:
                sightReadingExerciseCoordinator.SetIsGrandStaff(selectGrandStaff.Value);
                break;
            case SightReadingExerciseAction.SetHandsTogether setHandsTogether:
                sightReadingExerciseCoordinator.SetHandsTogether(setHandsTogether.Value);
                break;
            case SightReadingExerciseAction.SelectRhythmPreset selectRhythmPreset:
                sightReadingExerciseCoordinator.SetRhythmPreset(selectRhythmPreset.Value);
                break;
            case SightReadingExerciseAction.SelectMode selectMode:
                sightReadingExerciseCoordinator.SetMode(selectMode.Value);
                break;
            case SightReadingExerciseAction.SelectTempo selectTempo:
                sightReadingExerciseCoordinator.SetTempoPulsesPerMinute(selectTempo.Value);
                break;
            case SightReadingExerciseAction.SelectPacing selectPacing:
                sightReadingExerciseCoordinator.SetPacing(selectPacing.Value);
                break;
            case SightReadingExerciseAction.SetRevealNoteNames setRevealNoteNames:
                sightReadingExerciseCoordinator.SetRevealNoteNamesWhileActive(setRevealNoteNames.Value);
                await RefreshNotationVisibilityAsync();
                break;
            case SightReadingExerciseAction.SetRevealFingering setRevealFingering:
                sightReadingExerciseCoordinator.SetRevealFingeringWhileActive(setRevealFingering.Value);
                await RefreshNotationVisibilityAsync();
                break;
            case SightReadingExerciseAction.SetRevealKeys setRevealKeys:
                sightReadingExerciseCoordinator.SetRevealKeysWhileActive(setRevealKeys.Value);
                await RefreshNotationVisibilityAsync();
                break;
            case SightReadingExerciseAction.SetClickWhilePlaying setClickWhilePlaying:
                sightReadingExerciseCoordinator.SetClickWhilePlaying(setClickWhilePlaying.Value);
                break;
            case SightReadingExerciseAction.SetCoachHints setCoachHints:
                sightReadingExerciseCoordinator.SetCoachHints(setCoachHints.Value);
                break;
            case SightReadingExerciseAction.SetAutoNext setAutoNext:
                sightReadingExerciseCoordinator.SetAutoNext(setAutoNext.Value);
                EnsureAutoNextTicker();
                break;
            case SightReadingExerciseAction.CancelAutoNext:
                sightReadingExerciseCoordinator.CancelAutoNext();
                break;
            case SightReadingExerciseAction.ShowPreviousMeasures:
                ShowPreviousMeasures();
                break;
            case SightReadingExerciseAction.ShowNextMeasures:
                ShowNextMeasures();
                break;
            case SightReadingExerciseAction.Generate:
                await GenerateSightReadingExerciseAsync();
                break;
            case SightReadingExerciseAction.DrillWeakNotes:
                await DrillWeakSightReadingNotesAsync();
                break;
            case SightReadingExerciseAction.StartRecommended:
                await StartRecommendedSightReadingExerciseAsync();
                break;
            case SightReadingExerciseAction.Retry:
                await RetrySightReadingExerciseAsync();
                break;
            case SightReadingExerciseAction.RetryMissed:
                await RetryMissedSightReadingExerciseAsync();
                break;
            case SightReadingExerciseAction.End:
                await EndSightReadingExerciseAsync();
                break;
            default:
                throw new ArgumentOutOfRangeException(nameof(action), action, "Unsupported exercise action.");
        }
    }

    /// <summary>
    /// While an exercise is active the Timing card mirrors its time signature and tempo (as a loaded score does),
    /// so the manual metronome and the exercise cannot disagree. The values shown before the exercise are kept and
    /// put back when it ends.
    /// </summary>
    private void MirrorSightReadingExerciseTiming(Score score)
    {
        timingBeforeSightReadingExercise ??= (displayTimeSignature, displayTempo);
        displayTimeSignature = score.TimeSignature;
        displayTempo = score.Tempo;
    }

    private async Task DiscardSightReadingExerciseAsync()
    {
        await StopExerciseClickAsync();
        sightReadingExerciseCoordinator.End();
        if (timingBeforeSightReadingExercise is { } previousTiming)
        {
            displayTimeSignature = previousTiming.TimeSignature;
            displayTempo = previousTiming.Tempo;
            timingBeforeSightReadingExercise = null;
        }
    }

    /// <summary>
    /// Stops any conflicting playback/practice/metronome activity, clears tracked MIDI input, live audio, and
    /// wrong-note overlays, then returns the audio-clock time to use for the transition that follows. Shared by
    /// Generate, Retry, and End so a held note or stale overlay from the previous exercise can never leak into the
    /// next one.
    /// </summary>
    private async Task<TimeSpan> PrepareSightReadingExerciseTransitionAsync()
    {
        ExitFingeringEditMode();
        tempoFeedbackTracker.Reset();
        await sightReadingCountInTicker.StopAsync();
        sightReadingExerciseCoordinator.CancelCountIn();
        await AbortPracticeAsync(updateStatus: false);
        await StopScorePlaybackAsync();
        await visualizationTicker.StopAsync();
        if (Metronome.IsRunning)
        {
            await StopMetronomeAsync();
        }

        TimeSpan currentTime = AudioSession.IsInitialized
            ? await AudioSession.GetCurrentTimeAsync()
            : TimeSpan.Zero;
        midiInputState.Clear(currentTime);
        if (AudioSession.IsInitialized)
        {
            await AudioSession.ClearAsync(currentTime);
        }

        wrongScoreInputNotes.Clear();
        return currentTime;
    }

    private async Task GenerateSightReadingExerciseAsync()
    {
        TimeSpan currentTime = await PrepareSightReadingExerciseTransitionAsync();
        showPianoRoll = false;
        sightReadingExerciseCoordinator.Generate(
            Random.Shared,
            onTimeTolerance,
            sightReadingHistory.ComputeNoteMasteryWeakestFirst());
        ResetScoreWindowPair();
        await FinishSightReadingTransitionAsync(
            currentTime,
            "Note reading exercise ready. Play the highlighted note.");
    }

    /// <summary>
    /// Applies the ladder's recommendation to the exercise settings and generates it. The ladder only recommends: the
    /// settings it sets are ordinary ones the learner can change right back.
    /// </summary>
    private async Task StartRecommendedSightReadingExerciseAsync()
    {
        TimeSpan currentTime = await PrepareSightReadingExerciseTransitionAsync();
        showPianoRoll = false;
        sightReadingExerciseCoordinator.GenerateRecommended(
            Random.Shared,
            onTimeTolerance,
            sightReadingLadder.Recommended,
            sightReadingHistory.ComputeNoteMasteryWeakestFirst());
        ResetScoreWindowPair();
        await FinishSightReadingTransitionAsync(
            currentTime,
            $"Recommended exercise ready: {sightReadingLadder.Recommended.Level.Name}. Play the highlighted note.");
    }

    /// <summary>An explicit drill on the weak notes of the current range; ordinary generation is untouched.</summary>
    private async Task DrillWeakSightReadingNotesAsync()
    {
        if (!sightReadingExerciseCoordinator.GetDrillAvailability(sightReadingWeakNotes).IsAvailable)
        {
            return;
        }

        TimeSpan currentTime = await PrepareSightReadingExerciseTransitionAsync();
        showPianoRoll = false;
        sightReadingExerciseCoordinator.GenerateWeaknessDrill(Random.Shared, onTimeTolerance, sightReadingWeakNotes);
        ResetScoreWindowPair();
        await FinishSightReadingTransitionAsync(
            currentTime,
            "Weak-note drill ready. Play the highlighted note.");
    }

    private async Task RetrySightReadingExerciseAsync()
    {
        if (!IsSightReadingExerciseActive)
        {
            return;
        }

        TimeSpan currentTime = await PrepareSightReadingExerciseTransitionAsync();
        sightReadingExerciseCoordinator.Retry(onTimeTolerance);
        ResetScoreWindowPair();
        await FinishSightReadingTransitionAsync(
            currentTime,
            "Note reading exercise restarted. Play the highlighted note.");
    }

    private async Task RetryMissedSightReadingExerciseAsync()
    {
        if (!sightReadingExerciseCoordinator.HasMissedPrompts)
        {
            return;
        }

        TimeSpan currentTime = await PrepareSightReadingExerciseTransitionAsync();
        sightReadingExerciseCoordinator.RetryMissed(onTimeTolerance);
        ResetScoreWindowPair();
        await FinishSightReadingTransitionAsync(
            currentTime,
            "Retrying the notes you missed. Play the highlighted note.");
    }

    /// <summary>
    /// Completes a Generate/Retry/RetryMissed transition: in Pitch-only or Hold mode the exercise is immediately
    /// ready, exactly as before Task 16. In Rhythm mode it instead starts the exercise-owned metronome for one
    /// full-measure count-in (requires initialized audio) before any input is graded — see
    /// <see cref="TickSightReadingCountInAsync"/>.
    /// </summary>
    private async Task FinishSightReadingTransitionAsync(TimeSpan currentTime, string readyStatus)
    {
        MirrorSightReadingExerciseTiming(sightReadingExerciseCoordinator.Score!);
        if (sightReadingExerciseCoordinator.RunPacing == ExercisePacing.PlayAlong)
        {
            await StartSightReadingPlayAlongAsync(currentTime, readyStatus);
            return;
        }

        if (!sightReadingExerciseCoordinator.UsesCountIn)
        {
            if (sightReadingExerciseCoordinator.ShouldClickSound && AudioSession.IsInitialized)
            {
                await ExerciseClick.StartAsync(sightReadingExerciseCoordinator.Score!);
            }

            RefreshCanvasScene(currentTime);
            audioStatus = readyStatus;
            return;
        }

        if (!AudioSession.IsInitialized)
        {
            RefreshCanvasScene(currentTime);
            audioStatus = "Rhythm mode needs audio enabled for the count-in. Enable audio, then generate again.";
            return;
        }

        await ExerciseClick.StartAsync(sightReadingExerciseCoordinator.Score!);
        sightReadingExerciseCoordinator.StartCountIn(Metronome.Grid!.Anchor);
        RefreshCanvasScene(currentTime);
        audioStatus = $"Count-in: {sightReadingExerciseCoordinator.CountInTicksDue}…";
        sightReadingCountInTicker.Start(TickSightReadingCountInAsync, CanvasRefreshInterval);
    }

    /// <summary>
    /// Starts a play-along run for the generated exercise: the time-driven practice engine counts in, then a cursor
    /// sweeps the exercise whether or not the learner plays. All of the run's logic lives in
    /// <see cref="ExercisePlayAlongController"/>; the page only ticks it and redraws.
    /// </summary>
    private async Task StartSightReadingPlayAlongAsync(TimeSpan currentTime, string readyStatus)
    {
        if (!AudioSession.IsInitialized)
        {
            RefreshCanvasScene(currentTime);
            audioStatus = "Play-along needs audio enabled for the count-in. Enable audio, then generate again.";
            return;
        }

        await playAlongController.StartAsync(onTimeTolerance);
        practiceTicker.Start(TickSightReadingPlayAlongAsync, CanvasRefreshInterval);
        RefreshCanvasScene(currentTime);
        audioStatus = "Play-along count-in started.";
    }

    private async Task<bool> TickSightReadingPlayAlongAsync(CancellationToken cancellationToken)
    {
        if (!sightReadingExerciseCoordinator.IsActive)
        {
            return false;
        }

        bool isStillRunning = await playAlongController.UpdateAsync(cancellationToken);
        RefreshCanvasScene(
            practiceCoordinator.CurrentTime,
            playAlongController.VisibleCursorBeats,
            practiceCoordinator.GetVisibleVerdicts());
        audioStatus = playAlongController.State switch
        {
            PracticeSessionState.CountingIn => "Play-along count-in.",
            PracticeSessionState.Running => "Play-along in progress. Play the notes as the cursor reaches them.",
            PracticeSessionState.Finished => "Play-along complete.",
            _ => audioStatus,
        };
        if (!isStillRunning)
        {
            await SaveSightReadingHistoryIfCompletedAsync();
            EnsureVisualizationRefresh();
        }

        await InvokeAsync(StateHasChanged);
        return isStillRunning;
    }

    private async Task<bool> TickSightReadingCountInAsync(CancellationToken cancellationToken)
    {
        if (!sightReadingExerciseCoordinator.IsCountingIn)
        {
            return false;
        }

        bool didComplete = sightReadingExerciseCoordinator.TryCompleteCountIn(onTimeTolerance);
        TimeSpan currentTime = await AudioSession.GetCurrentTimeAsync(cancellationToken);
        RefreshCanvasScene(currentTime);
        if (didComplete)
        {
            if (!sightReadingExerciseCoordinator.ShouldClickSound)
            {
                await StopExerciseClickAsync();
            }

            audioStatus = "Rhythm exercise running. Play the highlighted note in time.";
        }
        else
        {
            audioStatus = $"Count-in: {sightReadingExerciseCoordinator.CountInTicksDue}…";
        }

        await InvokeAsync(StateHasChanged);
        return !didComplete;
    }

    private async Task EndSightReadingExerciseAsync()
    {
        if (!IsSightReadingExerciseActive)
        {
            return;
        }

        TimeSpan currentTime = await PrepareSightReadingExerciseTransitionAsync();
        await DiscardSightReadingExerciseAsync();
        ResetNoteReadingSession();
        ResetScoreWindowPair();
        RefreshCanvasScene(currentTime);
        audioStatus = selectedScore is null
            ? "Note reading exercise ended."
            : "Returned to the loaded score.";
    }

    private async Task StartPracticeAsync()
    {
        if (selectedScore is not { } score || !AudioSession.IsInitialized)
        {
            return;
        }

        ExitFingeringEditMode();
        await DiscardSightReadingExerciseAsync();
        if (Metronome.IsRunning)
        {
            await StopMetronomeAsync();
        }

        await StopScorePlaybackAsync();
        await AbortPracticeAsync(updateStatus: false);
        await visualizationTicker.StopAsync();
        ResetScoreWindowPair();
        TimeSpan currentTime = await AudioSession.GetCurrentTimeAsync();
        midiInputState.Clear(currentTime);
        await AudioSession.ClearAsync(currentTime);
        ResetNoteReadingSession();
        await practiceCoordinator.StartAsync(
            score,
            new GradingOptions { OnTimeTolerance = onTimeTolerance });
        practiceTicker.Start(TickPracticeAsync, CanvasRefreshInterval);
        RefreshCanvasScene(currentTime);
        audioStatus = "Practice count-in started.";
    }

    private async Task AbortPracticeFromControlAsync()
    {
        if (!AudioSession.IsInitialized)
        {
            return;
        }

        await AbortPracticeAsync(await AudioSession.GetCurrentTimeAsync());
    }

    private async Task StopScorePlaybackAsync()
    {
        await playbackTicker.StopAsync();
        scheduledKeyboardNotes = [];
        scoreCursorState = null;
        secondaryScoreCursorState = null;
        if (AudioSession.IsInitialized)
        {
            await ScorePlaybackSession.StopAsync();
        }

        if (NotationScore is not null)
        {
            RefreshCanvasScene(GetAnchorTime());
        }
    }

    private void ShowPreviousMeasures() => ChangeScorePage(pageDelta: -1);

    private void ShowNextMeasures() => ChangeScorePage(pageDelta: 1);

    private void ChangeScorePage(int pageDelta)
    {
        if (!CanPageScore(pageDelta) || NotationScore is not { } score)
        {
            return;
        }

        selectedScoreNoteAddress = null;
        scoreWindowPair = ScoreGrandStaffWindowPair.FromPageIndex(
            score.Measures.Count,
            (scoreWindowPair?.ActivePageIndex ?? 0) + pageDelta,
            visibleMeasureCount);
        // A learner paging through the review is still reading it, so the countdown to the next exercise starts over.
        sightReadingExerciseCoordinator.RestartAutoNext();
        if (!showPianoRoll)
        {
            RefreshCanvasScene(GetAnchorTime());
        }
    }

    // The small set of numbers JS needs to animate the score cursor itself, every animation
    // frame from audioContext.currentTime. Imported-score playback and timed practice share this
    // path; C# continues to update only the practice verdict and held-note overlay.
    private ScoreCursorPlaybackState? BuildScoreCursorState(
        Score score,
        ScoreCursorAnchor anchor,
        int firstVisibleMeasure,
        GrandStaffStaticScoreParts staticParts)
    {
        if (showPianoRoll)
        {
            return null;
        }

        var (cursorY0, cursorY1) = GrandStaffSceneBuilder.GetCursorLineYBounds();
        var measureStartBeats = new double[score.Measures.Count + 1];
        for (int measureIndex = 0; measureIndex < score.Measures.Count; measureIndex++)
        {
            measureStartBeats[measureIndex + 1] = measureStartBeats[measureIndex] +
                (score.Measures[measureIndex].LengthInBeats ?? score.TimeSignature.Numerator);
        }

        return new ScoreCursorPlaybackState(
            anchor.AnchorSeconds,
            anchor.BeatsPerMinute,
            score.TimeSignature.Numerator,
            measureStartBeats,
            firstVisibleMeasure,
            anchor.CompletionSeconds,
            cursorY0,
            cursorY1,
            visibleMeasureCount,
            GrandStaffSceneBuilder.CreateScoreCursorMeasureLayouts(
                staticParts,
                firstVisibleMeasure,
                visibleMeasureCount));
    }

    private void UpdateScoreCursorStates()
    {
        scoreCursorState = null;
        secondaryScoreCursorState = null;
    }

    private void UpdateScoreCursorStates(
        Score score,
        GrandStaffStaticScoreParts upperStaticParts,
        GrandStaffStaticScoreParts? lowerStaticParts)
    {
        if (scoreWindowPair is not { } pair || GetScoreCursorAnchor(score) is not { } anchor)
        {
            UpdateScoreCursorStates();
            return;
        }

        scoreCursorState = GetUpdatedScoreCursorState(
            scoreCursorState,
            score,
            anchor,
            pair.UpperFirstMeasure,
            upperStaticParts);
        secondaryScoreCursorState = pair.LowerFirstMeasure is { } lowerFirstMeasure && lowerStaticParts is { } staticParts
            ? GetUpdatedScoreCursorState(secondaryScoreCursorState, score, anchor, lowerFirstMeasure, staticParts)
            : null;
    }

    private ScoreCursorPlaybackState GetUpdatedScoreCursorState(
        ScoreCursorPlaybackState? current,
        Score score,
        ScoreCursorAnchor anchor,
        int firstVisibleMeasure,
        GrandStaffStaticScoreParts staticParts) =>
        current is not null &&
        current.AnchorSeconds == anchor.AnchorSeconds &&
        current.BeatsPerMinute == anchor.BeatsPerMinute &&
        current.CompletionSeconds == anchor.CompletionSeconds &&
        current.FirstVisibleMeasure == firstVisibleMeasure &&
        current.VisibleMeasureCount == visibleMeasureCount
            ? current
            : BuildScoreCursorState(score, anchor, firstVisibleMeasure, staticParts)!;

    private ScoreCursorAnchor? GetScoreCursorAnchor(Score score)
    {
        if (ScorePlaybackSession.IsActive && ScorePlaybackSession.GetCursorAnchor() is { } playbackAnchor)
        {
            return playbackAnchor;
        }

        return practiceCoordinator.State == PracticeSessionState.Running
            ? new ScoreCursorAnchor(
                practiceCoordinator.PracticeAnchor.TotalSeconds,
                score.Tempo.BeatsPerMinute,
                practiceCoordinator.PerformanceCompletionTime.TotalSeconds)
            : null;
    }

    private void ResetScoreWindowPair()
    {
        scoreWindowPair = NotationScore is { Measures.Count: > 0 } score
            ? ScoreGrandStaffWindowPair.FromPageIndex(score.Measures.Count, activePageIndex: 0, visibleMeasureCount)
            : null;
        UpdateScoreCursorStates();
    }

    private bool UpdateScoreWindowPairFromCursor(double cursorBeats)
    {
        if (NotationScore is not { Measures.Count: > 0 } score)
        {
            return false;
        }

        var updatedPair = ScoreGrandStaffWindowPair.FromCursorBeats(
            score,
            cursorBeats,
            visibleMeasureCount);
        if (updatedPair == scoreWindowPair)
        {
            return false;
        }

        scoreWindowPair = updatedPair;
        return true;
    }

    private Task OctaveDownAsync() =>
        ApplyInputCommandAsync(keyboardState.ChangeOctave(keyboardState.CurrentOctave - 1, GetAnchorTime()));

    private Task OctaveUpAsync() =>
        ApplyInputCommandAsync(keyboardState.ChangeOctave(keyboardState.CurrentOctave + 1, GetAnchorTime()));

    private Task SelectOctaveAsync(ChangeEventArgs eventArgs)
    {
        int octave = int.Parse((string)eventArgs.Value!, CultureInfo.InvariantCulture);
        return ApplyInputCommandAsync(keyboardState.ChangeOctave(octave, GetAnchorTime()));
    }

    private Task SelectMeterNumeratorAsync(ChangeEventArgs eventArgs)
    {
        int numerator = ParseClampedInteger(
            eventArgs,
            displayTimeSignature.Numerator,
            MinimumMeterNumerator,
            MaximumMeterNumerator);
        return ApplyTimingAsync(
            new TimeSignature(numerator, displayTimeSignature.BeatNoteValue),
            displayTempo);
    }

    private Task SelectBeatNoteAsync(ChangeEventArgs eventArgs)
    {
        int denominator = int.Parse((string)eventArgs.Value!, CultureInfo.InvariantCulture);
        return ApplyTimingAsync(
            new TimeSignature(displayTimeSignature.Numerator, new NoteValue(denominator)),
            displayTempo);
    }

    private Task SelectTempoAsync(ChangeEventArgs eventArgs)
    {
        int beatsPerMinute = ParseClampedInteger(
            eventArgs,
            (int)displayTempo.BeatsPerMinute,
            MinimumTempoBeatsPerMinute,
            MaximumTempoBeatsPerMinute);
        return ApplyTimingAsync(displayTimeSignature, new Tempo(beatsPerMinute));
    }

    private async Task SelectOnTimeToleranceAsync(ChangeEventArgs eventArgs)
    {
        int milliseconds = int.Parse((string)eventArgs.Value!, CultureInfo.InvariantCulture);
        onTimeTolerance = TimeSpan.FromMilliseconds(milliseconds);
        tempoFeedbackTracker.Reset();
        if (IsIdleNoteCheckingActive && SightReadingLabels.IsTimingGraded(ActiveNoteReadingMode))
        {
            ResetNoteReadingSession();
            TimeSpan currentTime = AudioSession.IsInitialized
                ? await AudioSession.GetCurrentTimeAsync()
                : TimeSpan.Zero;
            RefreshCanvasScene(currentTime);
        }

        audioStatus = $"On-time tolerance set to {milliseconds} ms.";
    }

    private async Task ToggleMetronomeAsync()
    {
        if (Metronome.IsRunning)
        {
            await StopMetronomeAsync();
            audioStatus = "Metronome off.";
        }
        else
        {
            await StartMetronomeAsync();
            audioStatus = $"Metronome on at {TimingLabel}.";
        }
    }

    private async Task StartMetronomeAsync()
    {
        tempoFeedbackTracker.Reset();
        await Metronome.StartAsync(displayTimeSignature, displayTempo);
    }

    private async Task StopMetronomeAsync()
    {
        await Metronome.StopAsync();
        tempoFeedbackTracker.Reset();
    }

    private async Task ApplyTimingAsync(TimeSignature timeSignature, Tempo tempo)
    {
        selectedScoreNoteAddress = null;
        bool metronomeWasRunning = Metronome.IsRunning;
        if (metronomeWasRunning)
        {
            await StopMetronomeAsync();
        }

        bool playbackWasActive = ScorePlaybackSession.IsActive || practiceCoordinator.IsActive;
        await AbortPracticeAsync(updateStatus: false);
        await StopScorePlaybackAsync();

        displayTimeSignature = timeSignature;
        displayTempo = tempo;
        if (importedScore is not null)
        {
            loadedScore = ScoreTiming.Apply(importedScore, timeSignature, tempo);
            selectedScore = loadedScore.Measures.Count == 0
                ? loadedScore
                : ScoreMeasureRange.Create(loadedScore, selectedFirstMeasure, selectedLastMeasure);
            ResetNoteReadingSession();
        }

        TimeSpan currentTime = AudioSession.IsInitialized
            ? await AudioSession.GetCurrentTimeAsync()
            : TimeSpan.Zero;
        if (metronomeWasRunning)
        {
            await StartMetronomeAsync();
        }

        RefreshCanvasScene(currentTime);
        audioStatus = metronomeWasRunning
            ? $"Metronome on at {TimingLabel}."
            : playbackWasActive
                ? $"Timing set to {TimingLabel}. Start playback again to use it."
                : $"Timing set to {TimingLabel}.";
    }

    private static int ParseClampedInteger(
        ChangeEventArgs eventArgs,
        int fallback,
        int minimum,
        int maximum)
    {
        bool parsed = int.TryParse(
            eventArgs.Value?.ToString(),
            NumberStyles.Integer,
            CultureInfo.InvariantCulture,
            out int value);
        return Math.Clamp(parsed ? value : fallback, minimum, maximum);
    }

    private async Task ToggleViewAsync()
    {
        TimeSpan currentTime = AudioSession.IsInitialized
            ? await AudioSession.GetCurrentTimeAsync()
            : TimeSpan.Zero;
        await SetViewAsync(currentTime);
    }

    private void ToggleSightReadingExercisePanel() =>
        showSightReadingExercisePanel = !showSightReadingExercisePanel;

    private void ToggleSightReadingProgressPanel() =>
        showSightReadingProgressPanel = !showSightReadingProgressPanel;

    private Task SetShowNoteLabelsAsync(ChangeEventArgs eventArgs)
    {
        showNoteLabels = eventArgs.Value is true;
        return RefreshNotationVisibilityAsync();
    }

    private Task SetShowFingeringsAsync(ChangeEventArgs eventArgs)
    {
        showFingerings = eventArgs.Value is true;
        return RefreshNotationVisibilityAsync();
    }

    private Task SetShowNextKeyHintsAsync(ChangeEventArgs eventArgs)
    {
        showNextKeyHints = eventArgs.Value is true;
        return RefreshNotationVisibilityAsync();
    }

    // A count change only re-windows which measures are drawn — it changes nothing about the
    // score's own data or timing — so it follows the lightweight RefreshNotationVisibilityAsync
    // pattern rather than ApplyTimingAsync's playback-stopping one. The page index is recomputed
    // from the previously active first measure (not reset to page 0) so the user's place in the
    // score is preserved across the count change.
    private Task SelectVisibleMeasureCountAsync(ChangeEventArgs eventArgs)
    {
        int oldFirstMeasure = scoreWindowPair?.UpperFirstMeasure ?? 0;
        visibleMeasureCount = ParseClampedInteger(
            eventArgs,
            visibleMeasureCount,
            MinimumVisibleMeasureCount,
            MaximumVisibleMeasureCount);

        if (selectedScore is { Measures.Count: > 0 } score)
        {
            scoreWindowPair = ScoreGrandStaffWindowPair.FromPageIndex(
                score.Measures.Count,
                oldFirstMeasure / visibleMeasureCount,
                visibleMeasureCount);
            UpdateScoreCursorStates();
        }

        return RefreshNotationVisibilityAsync();
    }

    private async Task SetFingeringEditModeAsync(ChangeEventArgs eventArgs)
    {
        bool isEnabled = eventArgs.Value is true;
        if (isEnabled && (loadedScore is null || selectedScore is null || showPianoRoll))
        {
            return;
        }

        if (isEnabled)
        {
            await AbortPracticeAsync(updateStatus: false);
            await StopScorePlaybackAsync();
            isFingeringEditing = true;
            showFingerings = true;
            selectedScoreNoteAddress = null;
            audioStatus = "Fingering edit mode enabled.";
        }
        else
        {
            ExitFingeringEditMode();
            audioStatus = "Fingering edit mode closed.";
        }

        ResetNoteReadingSession();
        TimeSpan currentTime = AudioSession.IsInitialized
            ? await AudioSession.GetCurrentTimeAsync()
            : TimeSpan.Zero;
        RefreshCanvasScene(currentTime);
    }

    private void SelectVisibleScoreNote(ChangeEventArgs eventArgs)
    {
        string value = eventArgs.Value?.ToString() ?? string.Empty;
        string[] parts = value.Split(':', count: 2);
        if (parts.Length != 2 ||
            !int.TryParse(parts[0], NumberStyles.Integer, CultureInfo.InvariantCulture, out int measureIndex) ||
            !int.TryParse(parts[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out int noteIndex))
        {
            selectedScoreNoteAddress = null;
            return;
        }

        HandleScoreNoteSelected(new ScoreNoteAddress(measureIndex, noteIndex));
    }

    private void HandleScoreNoteSelected(ScoreNoteAddress address)
    {
        if (isFingeringEditing && TryGetSelectedScoreNote(address, out _))
        {
            selectedScoreNoteAddress = address;
        }
    }

    private async Task SetSelectedFingeringAsync(int? fingerNumber)
    {
        if (!isFingeringEditing ||
            selectedScoreNoteAddress is not { } address ||
            importedScore is not { } sourceScore ||
            loadedScore is not { } currentScore ||
            !TryGetSelectedScoreNote(address, out ScoreNote? selectedNote) ||
            selectedNote is null)
        {
            return;
        }

        int noteOrdinal = ScoreNoteAddressResolver.ResolveOrdinal(
            currentScore,
            selectedFirstMeasure,
            address);
        Score editedScore = ScoreFingeringEditor.SetFingering(sourceScore, noteOrdinal, fingerNumber);
        await ApplyFingeringEditAsync(editedScore);
        audioStatus = fingerNumber is int number
            ? $"Set {selectedNote.Pitch} to finger {number}."
            : $"Removed fingering from {selectedNote.Pitch}.";
    }

    private async Task SetSelectedHandAsync(Staff hand)
    {
        if (!isFingeringEditing ||
            selectedScoreNoteAddress is not { } address ||
            importedScore is not { } sourceScore ||
            loadedScore is not { } currentScore ||
            !TryGetSelectedScoreNote(address, out ScoreNote? selectedNote) ||
            selectedNote is null)
        {
            return;
        }

        int noteOrdinal = ScoreNoteAddressResolver.ResolveOrdinal(
            currentScore,
            selectedFirstMeasure,
            address);
        Score editedScore = ScoreFingeringEditor.SetHand(sourceScore, noteOrdinal, hand);
        await ApplyFingeringEditAsync(editedScore);
        string handName = hand == Staff.Treble ? "right" : "left";
        audioStatus = $"Assigned {selectedNote.Pitch} to the {handName} hand.";
    }

    private async Task RegenerateAllFingeringsAsync()
    {
        if (importedScore is not { } sourceScore || isFingeringGenerating)
        {
            return;
        }

        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Regenerate the finger number for every note? Existing finger numbers will be replaced. Hand assignments will be preserved.");
        if (!confirmed)
        {
            return;
        }

        isFingeringGenerating = true;
        audioStatus = "Generating fingering numbers…";
        try
        {
            await AbortPracticeAsync(updateStatus: false);
            await StopScorePlaybackAsync();
            Score generatedScore = ScoreFingeringGenerator.Generate(sourceScore);
            showFingerings = true;
            await ApplyFingeringEditAsync(generatedScore);
            int noteCount = generatedScore.Measures.Sum(measure => measure.Notes.Count);
            string saveAction = loadedSavedScoreId.HasValue ? "Save changes" : "Save score";
            audioStatus = $"Generated fingering numbers for {noteCount} notes. Use {saveAction} to persist them.";
        }
        catch (InvalidOperationException exception)
        {
            audioStatus = $"Could not generate fingerings: {exception.Message}";
        }
        finally
        {
            isFingeringGenerating = false;
        }
    }

    private async Task ApplyFingeringEditAsync(Score editedScore)
    {
        importedScore = editedScore;
        loadedScore = ScoreTiming.Apply(importedScore, displayTimeSignature, displayTempo);
        selectedScore = loadedScore.Measures.Count == 0
            ? loadedScore
            : ScoreMeasureRange.Create(loadedScore, selectedFirstMeasure, selectedLastMeasure);
        ResetNoteReadingSession();
        TimeSpan currentTime = AudioSession.IsInitialized
            ? await AudioSession.GetCurrentTimeAsync()
            : TimeSpan.Zero;
        RefreshCanvasScene(currentTime);
    }

    private void ExitFingeringEditMode()
    {
        isFingeringEditing = false;
        selectedScoreNoteAddress = null;
    }

