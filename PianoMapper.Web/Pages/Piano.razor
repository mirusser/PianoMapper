            ? "The note reading exercise remains active. Play the highlighted note."
            : mode switch
            {
                NoteReadingMode.Off => "Idle note checking disabled.",
                NoteReadingMode.PitchAndOrder => "Pitch and order checking enabled. Play the highlighted score note.",
                NoteReadingMode.PitchAndHold => "Hold checking enabled. Play and hold the highlighted score notes.",
                NoteReadingMode.PitchHoldAndRhythm =>
                    "Rhythm checking enabled. Your first correct pitch starts the tempo timeline.",
                _ => throw new InvalidOperationException($"Unsupported note reading mode: {mode}."),
            };
    }

