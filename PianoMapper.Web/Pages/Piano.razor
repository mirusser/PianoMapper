    // A loaded score pages freely. An exercise in progress turns the pages itself as the learner plays, so it pages by
    // hand only once it is in review: a long exercise does not fit on the two score rows, and review marks on earlier
    // pages would otherwise be out of reach.
    private bool CanPageScore(int pageDelta) =>
        NotationScore is { } score && CanChangeScorePage(
            score.Measures.Count,
            scoreWindowPair?.ActivePageIndex ?? 0,
            pageDelta,
            ScorePlaybackSession.IsActive,
            practiceCoordinator.IsActive || sightReadingExerciseCoordinator.Phase == SightReadingExercisePhase.Active,
            visibleMeasureCount);

