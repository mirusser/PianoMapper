    /// <summary>
    /// True only while the exercise is being played (not yet complete). Unlike <see cref="IsSightReadingExerciseActive"/>,
    /// this is false during <see cref="SightReadingExercisePhase.Review"/> so note names and fingerings can be
    /// revealed once the exercise is complete.
    /// </summary>
    private bool IsSightReadingExerciseInProgress =>
        sightReadingExerciseCoordinator.Phase == SightReadingExercisePhase.Active;

    /// <summary>
    /// While the exercise is in progress, the exercise's own opt-in
    /// <see cref="SightReadingExerciseCoordinator.RevealNoteNamesWhileActive"/> "training wheels" setting decides
    /// visibility entirely on its own — independent of the general "Note names" toggle, which stays locked/disabled
    /// during an active exercise and shouldn't silently veto this setting. Once not in progress (no exercise, or
    /// it reached Review), this is exactly the pre-existing behavior: the general toggle alone decides.
    /// </summary>
    private bool EffectiveShowNoteLabels => IsSightReadingExerciseInProgress
        ? sightReadingExerciseCoordinator.RevealNoteNamesWhileActive
        : showNoteLabels;

    /// <summary>Same idea as <see cref="EffectiveShowNoteLabels"/>, for the "Fingering" toggle.</summary>
    private bool EffectiveShowFingerings => IsSightReadingExerciseInProgress
        ? sightReadingExerciseCoordinator.RevealFingeringWhileActive
        : showFingerings;

    /// <summary>
    /// Same idea as <see cref="EffectiveShowNoteLabels"/>, for the next-key hint on the 88-key piano: it stays off
    /// during an exercise unless the exercise itself opts in, since a lit key would give the answer away.
    /// </summary>
    private bool EffectiveShowNextKeyHints => IsSightReadingExerciseInProgress
        ? sightReadingExerciseCoordinator.RevealKeysWhileActive
        : showNextKeyHints;

