        !isFingeringEditing &&
        CanResetScoreHighlights(
            NotationScore is not null,
            IsNoteCheckingEnabled,
            ScorePlaybackSession.IsActive,
            practiceCoordinator.State != PracticeSessionState.Idle);

    private bool IsIdleNoteCheckingActive =>
        IsNoteCheckingEnabled &&
        NotationScore is not null &&
        !showPianoRoll &&
        !isFingeringEditing &&
        practiceCoordinator.State == PracticeSessionState.Idle &&
        !ScorePlaybackSession.IsActive &&
        !sightReadingExerciseCoordinator.IsCountingIn;

    private string SelectedScoreNoteAddressValue => selectedScoreNoteAddress is { } address
        ? FormatScoreNoteAddress(address)
        : string.Empty;

    private int? SelectedFingeringNumber => SelectedFingeringNote?.Fingering?.Number;

    private Staff? SelectedHand => SelectedFingeringNote?.Staff;

    private ScoreNote? SelectedFingeringNote =>
        selectedScoreNoteAddress is { } address && TryGetSelectedScoreNote(address, out ScoreNote? note)
            ? note
            : null;

    private string FingeringEditStatus =>
        selectedScoreNoteAddress is { } address && SelectedFingeringNote is { } note
            ? $"Selected {FormatFingeringNote(address, note)}. Current fingering: {note.Fingering?.Number.ToString(CultureInfo.InvariantCulture) ?? "none"}."
            : "Select a note on either grand-staff row, or choose one from the list.";

    private string? PrimaryScoreRangeLabel => FormatScoreRowRange(scoreWindowPair?.UpperFirstMeasure);

    private string? SecondaryScoreRangeLabel => FormatScoreRowRange(scoreWindowPair?.LowerFirstMeasure);

    private string? PrimaryScoreRowStatus => GetScoreRowStatus(scoreWindowPair?.UpperFirstMeasure);

    private string? SecondaryScoreRowStatus => GetScoreRowStatus(scoreWindowPair?.LowerFirstMeasure);

    private string? FormatScoreRowRange(int? firstMeasure)
    {
        if (NotationScore is not { } score || !firstMeasure.HasValue)
        {
            return null;
        }

        int lastMeasure = Math.Min(
            firstMeasure.Value + visibleMeasureCount,
            score.Measures.Count);
        return $"Measures {NotationMeasureNumberOffset + firstMeasure.Value + 1}–{NotationMeasureNumberOffset + lastMeasure}";
    }

    private string? GetScoreRowStatus(int? firstMeasure)
    {
        if (!firstMeasure.HasValue || scoreWindowPair is null)
        {
            return null;
        }

        return firstMeasure.Value == ActiveScoreFirstMeasure
            ? "Current"
            : firstMeasure.Value > ActiveScoreFirstMeasure
                ? "Look ahead"
                : "Previous";
    }

    private IReadOnlyList<(ScoreNoteAddress Address, ScoreNote Note)> GetVisibleFingeringNotes()
    {
        if (selectedScore is not { } score || scoreWindowPair is not { } windowPair)
        {
            return [];
        }

        var visibleMeasureIndexes = new SortedSet<int>();
        int?[] firstMeasures = [windowPair.UpperFirstMeasure, windowPair.LowerFirstMeasure];
        foreach (int firstMeasure in firstMeasures.OfType<int>())
        {
            int lastMeasure = Math.Min(
                firstMeasure + visibleMeasureCount,
                score.Measures.Count);
            for (int measureIndex = firstMeasure; measureIndex < lastMeasure; measureIndex++)
            {
                visibleMeasureIndexes.Add(measureIndex);
            }
        }

        var options = new List<(ScoreNoteAddress Address, ScoreNote Note)>();
        foreach (int measureIndex in visibleMeasureIndexes)
        {
            ScoreMeasure measure = score.Measures[measureIndex];
            for (int noteIndex = 0; noteIndex < measure.Notes.Count; noteIndex++)
            {
                options.Add((
                    new ScoreNoteAddress(measureIndex, noteIndex),
                    measure.Notes[noteIndex]));
            }
        }

        return options;
    }

    private string FormatFingeringNote(ScoreNoteAddress address, ScoreNote note)
    {
        string hand = note.Staff == Staff.Treble ? "right" : "left";
        string beat = (note.BeatOffset + 1).ToString("0.###", CultureInfo.CurrentCulture);
        return $"measure {selectedFirstMeasure + address.MeasureIndex + 1}, beat {beat}, {note.Pitch}, {hand} hand";
    }

    private static string FormatScoreNoteAddress(ScoreNoteAddress address) =>
        $"{address.MeasureIndex.ToString(CultureInfo.InvariantCulture)}:{address.NoteIndex.ToString(CultureInfo.InvariantCulture)}";

    private bool TryGetSelectedScoreNote(ScoreNoteAddress address, out ScoreNote? note)
    {
        note = null;
        if (selectedScore is not { } score ||
            address.MeasureIndex < 0 ||
            address.MeasureIndex >= score.Measures.Count ||
            address.NoteIndex < 0 ||
            address.NoteIndex >= score.Measures[address.MeasureIndex].Notes.Count)
        {
            return false;
        }

        note = score.Measures[address.MeasureIndex].Notes[address.NoteIndex];
        return true;
    }

    internal static bool CanChangeScorePage(
        int measureCount,
        int activePageIndex,
        int pageDelta,
        bool isScorePlaybackActive,
        bool isPracticeActive,
        int visibleMeasureCount = GrandStaffLayout.DefaultVisibleMeasureCount)
    {
        if (measureCount <= 0 || isScorePlaybackActive || isPracticeActive)
        {
            return false;
        }

        int pageCount = (measureCount + visibleMeasureCount - 1) / visibleMeasureCount;
        int requestedPageIndex = activePageIndex + pageDelta;
        return requestedPageIndex >= 0 && requestedPageIndex < pageCount;
    }

    internal static bool CanResetScoreHighlights(
        bool hasScore,
        bool isNoteCheckingEnabled,
        bool isScorePlaybackActive,
        bool isPracticeActive) =>
        hasScore && isNoteCheckingEnabled && !isScorePlaybackActive && !isPracticeActive;

    public Piano()
    {
        keyboardState = new BrowserKeyboardState(initialOctave: 4);
        noteInputState = new BrowserNoteInputState(noteTimeline);
        midiInputState = new BrowserMidiInputState(noteInputState);
        computerPianoState = new BrowserComputerPianoState(noteInputState);
        sightReadingExerciseCoordinator = new SightReadingExerciseCoordinator(noteReadingSession);
    }

    protected override void OnInitialized()
    {
        practiceCoordinator = new BrowserPracticeCoordinator(AudioSession, noteTimeline);
        playAlongController = new ExercisePlayAlongController(
            practiceCoordinator,
            sightReadingExerciseCoordinator,
            ExerciseClick);
        sightReadingHistoryStore = new BrowserSightReadingHistoryStore(JS);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        sightReadingHistory = await sightReadingHistoryStore.LoadAsync();
        RefreshSightReadingInsights();
        StateHasChanged();
        await TryAutoConnectMidiAsync();
        StateHasChanged();
        await EnableAudioAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Recomputes what the history says (the insights and the weak notes a drill would use) once per change, not on
    /// every render, since the page re-renders on every key press.
    /// </summary>
    private void RefreshSightReadingInsights()
    {
        sightReadingInsights = SightReadingInsights.Build(sightReadingHistory);
        sightReadingWeakNotes = SightReadingInsights.GetWeakNotes(sightReadingHistory);
        sightReadingLadder = LevelProgression.Evaluate(sightReadingHistory);
    }

    private async Task StopExerciseClickAsync()
    {
        if (ExerciseClick.IsRunning)
        {
            await ExerciseClick.StopAsync();
            tempoFeedbackTracker.Reset();
        }
    }

    private async Task SaveSightReadingHistoryIfCompletedAsync()
    {
        if (!sightReadingExerciseCoordinator.ShouldClickSound)
        {
            await StopExerciseClickAsync();
        }

        if (sightReadingExerciseCoordinator.ConsumeCompletionSummary() is not { } summary)
        {
            return;
        }

        sightReadingHistory = sightReadingHistory.WithCompletedSession(summary);
        RefreshSightReadingInsights();
        await sightReadingHistoryStore.SaveAsync(sightReadingHistory);
        EnsureAutoNextTicker();
    }

    private void EnsureAutoNextTicker()
    {
        if (sightReadingExerciseCoordinator.AutoNextRemaining is null || autoNextTicker.IsRunning)
        {
            return;
        }

        autoNextTicker.Start(TickAutoNextAsync, AutoNextRefreshInterval);
    }

    /// <summary>
    /// Redraws the countdown and, when it runs out, generates the next exercise exactly as the Generate button does. The
    /// loop ends by itself once the countdown is gone (cancelled, or a new run started), so nothing has to stop it, which
    /// matters because generating from inside the loop must not await the loop.
    /// </summary>
    private async Task<bool> TickAutoNextAsync(CancellationToken cancellationToken)
    {
        if (sightReadingExerciseCoordinator.AutoNextRemaining is null)
        {
            return false;
        }

        if (sightReadingExerciseCoordinator.IsAutoNextDue)
        {
            await GenerateSightReadingExerciseAsync();
            await InvokeAsync(StateHasChanged);
            return false;
        }

        await InvokeAsync(StateHasChanged);
        return true;
    }

    private async Task ClearSightReadingHistoryAsync()
    {
        sightReadingHistory = SightReadingHistory.Empty;
        RefreshSightReadingInsights();
        await sightReadingHistoryStore.ClearAsync();
    }

    private async Task EnableAudioAsync()
    {
        try
        {
            audioClockAnchor = await AudioSession.InitializeAsync();
            soundSource = await AudioSession.GetSoundSourceAsync();
            await AttachKeyboardAsync();
            audioStatus = AudioReadyStatus;
            EnsureVisualizationRefresh();
        }
        catch (JSException exception)
        {
            audioStatus = $"Audio could not start: {exception.Message} Select Enable audio to retry.";
        }
    }

    private async Task PlayTestNoteAsync()
    {
        await AudioSession.StartNoteAsync(TestNoteId, TestPitch, GetAnchorTime(), shouldMeasureLatency: false);
        testNoteIsActive = true;
        RefreshKeyboardState(GetAnchorTime());
        audioStatus = "Test note is playing.";
    }

    private async Task StopTestNoteAsync()
    {
        await AudioSession.StopNoteAsync(TestNoteId, GetAnchorTime());
        testNoteIsActive = false;
        RefreshKeyboardState(GetAnchorTime());
        audioStatus = AudioReadyStatus;
    }

    private async Task SelectSoundSourceAsync(BrowserSoundSource selectedSource)
    {
        if (!AudioSession.IsInitialized || selectedSource == soundSource || isSoundSourceChanging)
        {
            return;
        }

        isSoundSourceChanging = true;
        audioStatus = selectedSource switch
        {
            BrowserSoundSource.Piano => "Loading PC piano samples...",
            BrowserSoundSource.ExternalMidi => "Switching sound to the FP-10...",
            _ => "Switching to synth audio...",
        };
        try
        {
            await AbortPracticeAsync(updateStatus: false);
            await StopScorePlaybackAsync();
            TimeSpan currentTime = await AudioSession.GetCurrentTimeAsync();
            midiInputState.Clear(currentTime);
            await AudioSession.ClearAsync(currentTime);
            testNoteIsActive = false;
            RefreshCanvasScene(currentTime);
            await AudioSession.SetSoundSourceAsync(selectedSource);
            soundSource = selectedSource;
            audioStatus = AudioReadyStatus;
        }
        catch (JSException exception)
        {
            audioStatus = $"Sound could not change: {exception.Message}";
        }
        finally
        {
            isSoundSourceChanging = false;
        }
    }

    private async Task ClearNotesAsync()
    {
        await ApplyInputCommandAsync(keyboardState.Clear(GetAnchorTime()));
    }

    private async Task SetComputerPianoEnabledAsync(ChangeEventArgs eventArgs)
    {
        bool isEnabled = eventArgs.Value is true;
        computerPianoState.SetEnabled(isEnabled);

        // Stuck-note safety: turning the toggle off mid-hold must not leave a note sounding forever, since a
        // disabled computer piano will never see the matching key-up for whatever's still held.
        if (!isEnabled)
        {
            foreach (BrowserInputCommand command in computerPianoState.ReleaseAll(GetAnchorTime()))
            {
                await ApplyInputCommandAsync(command);
            }
        }
    }

    private async Task ConnectMidiAsync()
    {
        if (isMidiConnecting)
        {
            return;
        }

        isMidiConnecting = true;
        midiStatus = "Connecting MIDI piano...";
        await InvokeAsync(StateHasChanged);
        try
        {
            midiModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/midi.js");
            inputReference ??= DotNetObjectReference.Create(this);
            var status = await midiModule.InvokeAsync<BrowserMidiConnectionStatus>(
                "connect",
                inputReference);
            UpdateMidiConnectionStatus(status);
        }
        catch (JSException exception)
        {
            midiInputNames = [];
            midiOutputName = null;
            midiStatus = $"MIDI could not connect: {exception.Message} Allow MIDI access and retry.";
        }
        finally
        {
            isMidiConnecting = false;
            RefreshExternalMidiAudioStatus();
        }
    }

    private async Task TryAutoConnectMidiAsync()
    {
        if (isMidiConnecting)
        {
            return;
        }

        isMidiConnecting = true;
        try
        {
            midiModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/midi.js");
            inputReference ??= DotNetObjectReference.Create(this);
            var status = await midiModule.InvokeAsync<BrowserMidiConnectionStatus>(
                "connectIfPermitted",
                inputReference);
            UpdateMidiConnectionStatus(status);
        }
        catch (JSException exception)
        {
            midiInputNames = [];
            midiOutputName = null;
            midiStatus = $"MIDI could not connect: {exception.Message} Select Connect MIDI piano to retry.";
        }
        finally
        {
            isMidiConnecting = false;
            RefreshExternalMidiAudioStatus();
        }
    }

    private async Task ShowTimingAsync()
    {
        var summary = await AudioSession.GetSchedulingLatencyAsync();
        audioStatus = summary.SampleCount == 0
            ? "No keyboard timing samples recorded yet."
            : $"{summary.SampleCount} samples: median {summary.MedianMilliseconds:F1} ms, p95 {summary.P95Milliseconds:F1} ms.";
    }

    private async Task HandleScoreLoadedAsync(Score score)
    {
        ExitFingeringEditMode();
        await DiscardSightReadingExerciseAsync();
        await AbortPracticeAsync(updateStatus: false);
        await StopScorePlaybackAsync();
        bool metronomeWasRunning = Metronome.IsRunning;
        if (metronomeWasRunning)
        {
            await StopMetronomeAsync();
        }

        importedScore = score;
        loadedScore = score;
        selectedFirstMeasure = 0;
        selectedLastMeasure = Math.Max(0, score.Measures.Count - 1);
        selectedScore = score.Measures.Count == 0
            ? score
            : ScoreMeasureRange.Create(score, selectedFirstMeasure, selectedLastMeasure);
        ResetNoteReadingSession();
        displayTimeSignature = score.TimeSignature;
        displayTempo = score.Tempo;
        if (metronomeWasRunning)
        {
            await StartMetronomeAsync();
            audioStatus = $"Metronome on at {TimingLabel}.";
        }

        ResetScoreWindowPair();
        TimeSpan currentTime = AudioSession.IsInitialized
            ? await AudioSession.GetCurrentTimeAsync()
            : TimeSpan.Zero;
        RefreshCanvasScene(currentTime);
    }

    private async Task HandleImportedScoreLoadedAsync(Score score)
    {
        loadedSavedScoreId = null;
        await HandleScoreLoadedAsync(score);
    }

    private async Task HandleSavedScoreLoadedAsync(SavedScoreDetails savedScore)
    {
        await HandleScoreLoadedAsync(savedScore.Score);
        loadedSavedScoreId = savedScore.Id;
    }

    private void HandleSavedScoreSaved(SavedScoreDetails savedScore) =>
        loadedSavedScoreId = savedScore.Id;

    private void HandleSavedScoreDeleted(Guid id)
    {
