@page "/"
@implements IAsyncDisposable
@inject WebAudioSession AudioSession
@inject BrowserMetronome Metronome
@inject ExerciseClick ExerciseClick
@inject BrowserScorePlayback ScorePlaybackSession
@inject IJSRuntime JS

<PageTitle>PianoMapper</PageTitle>

<main>
    <header class="page-header">
        <div>
            <p class="eyebrow">PianoER</p>
        </div>
        <p class="status-chip" role="status">@audioStatus</p>
    </header>
    <section @ref="playSurface" class="play-surface" tabindex="0" aria-label="Piano play surface">
        <div class="control-dashboard">
            <AudioControls IsInitialized="@AudioSession.IsInitialized"
                           SoundSource="@soundSource"
                           IsSoundSourceChanging="@isSoundSourceChanging"
                           MidiOutputName="@midiOutputName"
                           IsTestNoteActive="@testNoteIsActive"
                           IsMidiConnecting="@isMidiConnecting"
                           HasMidiConnection="@HasMidiConnection"
                           MidiStatus="@midiStatus"
                           MidiInputSummary="@MidiInputSummary"
                           MidiOutputSummary="@MidiOutputSummary"
                           EnableAudio="EnableAudioAsync"
                           SoundSourceSelected="SelectSoundSourceAsync"
                           PlayTestNote="PlayTestNoteAsync"
                           StopTestNote="StopTestNoteAsync"
                           ShowTiming="ShowTimingAsync"
                           ConnectMidi="ConnectMidiAsync" />

            <details class="score-card control-card-wide settings-card" aria-labelledby="score-card-heading" open>
                <summary class="control-card-heading">
                    <h2 id="score-card-heading">Imported score</h2>
                    <span>@(loadedScore is not null ? loadedScore.Title : "No score loaded")</span>
                </summary>
                <div class="score-library-column">
                    <ScoreFilePicker ScoreLoaded="HandleImportedScoreLoadedAsync"
                                     HasLoadedScore="@(loadedScore is not null)" />
                    <SavedScoreLibrary CurrentScore="@loadedScore"
                                       CurrentSavedScoreId="@loadedSavedScoreId"
                                       ScoreLoaded="HandleSavedScoreLoadedAsync"
                                       ScoreSaved="HandleSavedScoreSaved"
                                       ScoreDeleted="HandleSavedScoreDeleted" />
                </div>
                @if (loadedScore is not null && selectedScore is not null)
                {
                    <div class="score-playback-column">
                        <div class="control-card-heading">
                            <p class="score-title">@loadedScore.Title — @loadedScore.Measures.Count measure(s)</p>
                            <button class="button-quiet" type="button" @onclick="HandleScoreUnloadedAsync">
                                Unload score
                            </button>
                        </div>
                        <div class="control-card-groups">
                            <div class="control-group" role="group" aria-labelledby="measure-range-heading">
                                <span class="control-group-label" id="measure-range-heading">Measure range</span>
                                <div class="controls">
                                    <label class="octave-picker">
                                        From
                                        <select value="@(selectedFirstMeasure + 1)"
                                                @onchange="SelectFirstMeasureAsync"
                                                aria-label="First measure to play">
                                            @for (int measureNumber = 1; measureNumber <= loadedScore.Measures.Count; measureNumber++)
                                            {
                                                <option value="@measureNumber">@measureNumber</option>
                                            }
                                        </select>
                                    </label>
                                    <label class="octave-picker">
                                        To
                                        <select value="@(selectedLastMeasure + 1)"
                                                @onchange="SelectLastMeasureAsync"
                                                aria-label="Last measure to play">
                                            @for (int measureNumber = 1; measureNumber <= loadedScore.Measures.Count; measureNumber++)
                                            {
                                                <option value="@measureNumber">@measureNumber</option>
                                            }
                                        </select>
                                    </label>
                                </div>
                            </div>
                            <div class="control-group" role="group" aria-label="Score navigation">
                                <span class="control-group-label">Playback</span>
                                <div class="controls">
                                    <button class="button-primary"
                                            type="button"
                                            @onclick="StartScorePlaybackAsync"
                                            disabled="@(!AudioSession.IsInitialized)">
                                        Play / restart <kbd>P</kbd>
                                    </button>
                                    <button type="button" @onclick="ShowPreviousMeasures" disabled="@(!CanShowPreviousMeasures)">
                                        Previous <kbd>[</kbd>
                                    </button>
                                    <span class="measure-window">
                                        Measures @(selectedFirstMeasure + ActiveScoreFirstMeasure + 1)–@(
                                            selectedFirstMeasure + Math.Min(
                                                ActiveScoreFirstMeasure + visibleMeasureCount,
                                                selectedScore.Measures.Count))
                                    </span>
                                    <button type="button"
                                            @onclick="ShowNextMeasures"
                                            disabled="@(!CanShowNextMeasures)">
                                        Next <kbd>]</kbd>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="control-card-groups">
                            <div class="control-group">
                                <span class="control-group-label">Practice</span>
                                <PracticePanel State="@practiceCoordinator.State"
                                               Result="@practiceCoordinator.Result"
                                               CountInTicksDue="@practiceCoordinator.CountInTicksDue"
                                               TotalCountInTicks="@loadedScore.TimeSignature.Numerator"
                                               CanStart="@AudioSession.IsInitialized"
                                               IsActive="@practiceCoordinator.IsActive"
                                               IdleNoteReadingMode="@idleNoteReadingMode"
                                               Start="StartPracticeAsync"
                                               Abort="AbortPracticeFromControlAsync"
                                               IdleNoteReadingModeChanged="SetIdleNoteReadingModeAsync" />
                            </div>
                        </div>
                    </div>
                }
            </details>

            <details class="control-card control-card-wide settings-card" aria-labelledby="play-controls-heading">
                <summary class="control-card-heading">
                    <h2 id="play-controls-heading">Play &amp; MIDI tools</h2>
                    <span>C@(keyboardState.CurrentOctave)–C@(keyboardState.CurrentOctave + 1)</span>
                </summary>
                <div class="control-column">
                    <div class="control-sections">
                        <div role="group" aria-labelledby="play-tools-heading">
                            <span class="control-group-label" id="play-tools-heading">Play tools</span>
                            <div class="controls controls-centered">
                                <button type="button" @onclick="ClearNotesAsync" disabled="@(!AudioSession.IsInitialized)">
                                    Clear notes <kbd>C</kbd>
                                </button>
                                <button type="button" @onclick="PlayRandomMeasureAsync" disabled="@(!AudioSession.IsInitialized)">
                                    Random measure <kbd>M</kbd>
                                </button>
                                <button class="button-quiet"
                                        type="button"
                                        @onclick="ToggleViewAsync"
                                        disabled="@IsSightReadingExerciseActive">
                                    Show @(showPianoRoll ? "staff" : "piano roll") <kbd>V</kbd>
                                </button>
                            </div>
                        </div>

                        <div role="group" aria-labelledby="keyboard-range-heading">
                            <span class="control-group-label" id="keyboard-range-heading">Notation focus</span>
                            <div class="controls controls-centered octave-controls">
                                <button type="button"
                                        @onclick="OctaveDownAsync"
                                        disabled="@(keyboardState.CurrentOctave == 1)"
                                        aria-label="Select the previous octave">
                                    Down
                                </button>
                                <label class="octave-picker">
                                    Octave
                                    <select value="@keyboardState.CurrentOctave" @onchange="SelectOctaveAsync">
                                        @for (int octave = 1; octave <= 8; octave++)
                                        {
                                            <option value="@octave">@octave</option>
                                        }
                                    </select>
                                </label>
                                <button type="button"
                                        @onclick="OctaveUpAsync"
                                        disabled="@(keyboardState.CurrentOctave == 8)"
                                        aria-label="Select the next octave">
                                    Up
                                </button>
                            </div>
                        </div>

                        <div role="group" aria-labelledby="computer-piano-heading">
                            <span class="control-group-label" id="computer-piano-heading">Computer keyboard</span>
                            <div class="control-grid">
                                <label class="control-checkbox">
                                    <input type="checkbox"
                                           checked="@computerPianoState.IsEnabled"
                                           @onchange="SetComputerPianoEnabledAsync" />
                                    Play notes with the keyboard
                                </label>
                            </div>
                            <p class="control-note">
                                Optional — MIDI and the on-screen keys both work without it. When on, maps
                                <kbd>Z</kbd> through <kbd>/</kbd> to white and black keys starting at
                                C@(keyboardState.CurrentOctave), following the octave selected above.
                            </p>
                        </div>

                        <div role="group" aria-labelledby="notation-heading">
                            <span class="control-group-label" id="notation-heading">Notation</span>
                            <div class="control-grid">
                                <label class="control-checkbox">
                                    <input type="checkbox"
                                           checked="@showNoteLabels"
                                           disabled="@IsSightReadingExerciseActive"
                                           @onchange="SetShowNoteLabelsAsync" />
                                    Note names
                                </label>
                                <label class="control-checkbox">
                                    <input type="checkbox"
                                           checked="@showFingerings"
                                           disabled="@(isFingeringEditing || IsSightReadingExerciseActive)"
                                           @onchange="SetShowFingeringsAsync" />
                                    Fingering
                                </label>
                                <label class="control-checkbox">
                                    <input type="checkbox"
                                           checked="@showNextKeyHints"
                                           disabled="@IsSightReadingExerciseActive"
                                           @onchange="SetShowNextKeyHintsAsync" />
                                    Highlight next keys on the piano
                                </label>
                                <label class="timing-field">
                                    <span>Measures per page</span>
                                    <input type="number"
                                           min="@MinimumVisibleMeasureCount"
                                           max="@MaximumVisibleMeasureCount"
                                           step="1"
                                           value="@visibleMeasureCount"
                                           @onchange="SelectVisibleMeasureCountAsync" />
                                </label>
                                @if (loadedScore is not null && selectedScore is not null &&
                                    sightReadingExerciseCoordinator.Score is null && !showPianoRoll)
                                {
                                    <label class="control-checkbox">
                                        <input type="checkbox"
                                               checked="@isFingeringEditing"
                                               @onchange="SetFingeringEditModeAsync" />
                                        Edit fingering
                                    </label>
                                    <button type="button"
                                            disabled="@isFingeringGenerating"
                                            title="Replace every existing fingering number"
                                            @onclick="RegenerateAllFingeringsAsync">
                                        @(isFingeringGenerating ? "Generating fingerings…" : "Regenerate all fingerings")
                                    </button>
                                }
                            </div>
                            @if (isFingeringEditing)
                            {
                                <div class="fingering-editor" aria-label="Fingering editor">
                                    <label class="fingering-note-picker">
                                        Note
                                        <select value="@SelectedScoreNoteAddressValue"
                                                @onchange="SelectVisibleScoreNote">
                                            <option value="">Select a visible note</option>
                                            @foreach (var option in GetVisibleFingeringNotes())
                                            {
                                                <option value="@FormatScoreNoteAddress(option.Address)">
                                                    @FormatFingeringNote(option.Address, option.Note)
                                                </option>
                                            }
                                        </select>
                                    </label>
                                    <div>
                                        <span class="control-group-label" id="fingering-number-heading">Finger</span>
                                        <div class="controls" role="group" aria-labelledby="fingering-number-heading">
                                            @for (int number = 1; number <= 5; number++)
                                            {
                                                int fingerNumber = number;
                                                <button class="@(SelectedFingeringNumber == fingerNumber ? "button-primary" : null)"
                                                        type="button"
                                                        aria-pressed="@(SelectedFingeringNumber == fingerNumber ? "true" : "false")"
                                                        disabled="@(selectedScoreNoteAddress is null)"
                                                        @onclick="() => SetSelectedFingeringAsync(fingerNumber)">
                                                    @fingerNumber
                                                </button>
                                            }
                                            <button type="button"
                                                    disabled="@(SelectedFingeringNumber is null)"
                                                    @onclick="() => SetSelectedFingeringAsync(null)">
                                                Remove
                                            </button>
                                        </div>
                                    </div>
                                    <div>
                                        <span class="control-group-label" id="fingering-hand-heading">Hand</span>
                                        <div class="controls" role="group" aria-labelledby="fingering-hand-heading">
                                            <button class="@(SelectedHand == Staff.Treble ? "button-primary" : null)"
                                                    type="button"
                                                    aria-pressed="@(SelectedHand == Staff.Treble ? "true" : "false")"
                                                    disabled="@(selectedScoreNoteAddress is null)"
                                                    @onclick="() => SetSelectedHandAsync(Staff.Treble)">
                                                Right hand
                                            </button>
                                            <button class="@(SelectedHand == Staff.Bass ? "button-primary" : null)"
                                                    type="button"
                                                    aria-pressed="@(SelectedHand == Staff.Bass ? "true" : "false")"
                                                    disabled="@(selectedScoreNoteAddress is null)"
                                                    @onclick="() => SetSelectedHandAsync(Staff.Bass)">
                                                Left hand
                                            </button>
                                        </div>
                                    </div>
                                    <p class="control-note" role="status">@FingeringEditStatus</p>
                                </div>
                            }
                        </div>
                    </div>
                    <p class="control-note">
                        The notation focus controls the live staff view. MIDI notes retain their actual piano octaves.
                    </p>
                </div>
            </details>
        </div>

        <details class="control-card control-card-wide settings-card timing-metronome-card" aria-labelledby="timing-controls-heading">
            <summary class="control-card-heading">
                <h2 id="timing-controls-heading">Timing &amp; metronome</h2>
                <span>@TimingLabel</span>
            </summary>
            <div class="timing-controls">
                <label class="timing-field">
                    <span>Beats per measure</span>
                    <input type="number"
                           min="@MinimumMeterNumerator"
                           max="@MaximumMeterNumerator"
                           step="1"
                           value="@displayTimeSignature.Numerator"
                           disabled="@IsSightReadingExerciseActive"
                           @onchange="SelectMeterNumeratorAsync" />
                </label>
                <label class="timing-field">
                    <span>One beat is a</span>
                    <select value="@displayTimeSignature.BeatNoteValue.Denominator"
                            disabled="@IsSightReadingExerciseActive"
                            @onchange="SelectBeatNoteAsync">
                        <option value="1">Whole note (1)</option>
                        <option value="2">Half note (2)</option>
                        <option value="4">Quarter note (4)</option>
                        <option value="8">Eighth note (8)</option>
                        <option value="16">Sixteenth note (16)</option>
                    </select>
                </label>
                <label class="timing-field">
                    <span>Tempo (BPM)</span>
                    <input type="number"
                           min="@MinimumTempoBeatsPerMinute"
                           max="@MaximumTempoBeatsPerMinute"
                           step="1"
                           value="@TempoBeatsPerMinuteText"
                           disabled="@IsSightReadingExerciseActive"
                           @onchange="SelectTempoAsync" />
                </label>
                <label class="timing-field">
                    <span>On-time tolerance</span>
                    <select value="@OnTimeToleranceMilliseconds"
                            @onchange="SelectOnTimeToleranceAsync">
                        <option value="@StrictToleranceMilliseconds">Strict (30 ms)</option>
                        <option value="@NormalToleranceMilliseconds">Normal (60 ms)</option>
                        <option value="@RelaxedToleranceMilliseconds">Relaxed (100 ms)</option>
                    </select>
                </label>
            </div>
            <MetronomeControls IsRunning="@Metronome.IsRunning"
                                CanToggle="@AudioSession.IsInitialized"
                                Feedback="@tempoFeedbackTracker"
                                Toggle="ToggleMetronomeAsync" />
            <p class="control-note">
                Timing changes stop score or practice playback. A running metronome restarts on the new beat grid.
            </p>
            @if (IsSightReadingExerciseActive)
            {
                <p class="control-note" role="status">
                    The note reading exercise sets the beats, beat note and tempo while it is active. Change its
                    tempo in the exercise panel, or end the exercise to edit them here.
                </p>
            }
            <details class="learning-disclosure">
                <summary>Understand the timing controls</summary>
                <dl class="music-term-grid">
                    <div>
                        <dt>Beat</dt>
                        <dd>
                            The pulse you tap or count. The “One beat is a” control chooses the note value assigned
                            to each metronome click in PianoMapper.
                        </dd>
                    </div>
                    <div>
                        <dt>Measure (or bar)</dt>
                        <dd>
                            One group of beats between two barlines. With three beats per measure, the count returns
                            to beat one after every third beat.
                        </dd>
                    </div>
                    <div>
                        <dt>Time signature</dt>
                        <dd>
                            PianoMapper combines the first two controls as the written pair. 3/4 means three beats
                            per measure and a quarter note receives one beat.
                        </dd>
                    </div>
                    <div>
                        <dt>Note value</dt>
                        <dd>
                            Whole, half, quarter, eighth, and sixteenth notes describe relative duration. A half
                            note lasts twice as long as a quarter note; an eighth lasts half as long.
                        </dd>
                    </div>
                    <div>
                        <dt>Tempo (BPM)</dt>
                        <dd>
                            Beats per minute converts the selected beat into clock time. At 120 BPM, each beat lasts
                            half a second.
                        </dd>
                    </div>
                    <div>
                        <dt>On-time tolerance</dt>
                        <dd>
                            With Normal selected, PianoMapper marks onsets within 60 ms of their expected time as on
                            time. Larger deviations are early or late. Hold-aware idle checking uses the same tolerance
                            around each expected release time.
                        </dd>
                    </div>
                </dl>
                <p class="learning-links">
                    For illustrated walkthroughs, see
                    <a href="https://www.musictheory.net/lessons/11" target="_blank" rel="noopener noreferrer">Note Duration</a>
                    and
                    <a href="https://www.musictheory.net/lessons/12" target="_blank" rel="noopener noreferrer">Measures and Time Signature</a>
                    on MusicTheory.net.
                </p>
            </details>
        </details>

        <PianoCanvas Scene="@canvasScene"
                     SecondaryScene="@secondaryCanvasScene"
                     SelectedOctave="@keyboardState.CurrentOctave"
                     IsScoreView="@(NotationScore is not null && !showPianoRoll)"
                     CanResetScoreHighlights="@CanResetHighlights"
                     ResetScoreHighlights="ResetScoreHighlightsAsync"
                     CanSelectScoreNotes="@isFingeringEditing"
                     SelectedScoreNote="@selectedScoreNoteAddress"
                     ScoreNoteSelected="HandleScoreNoteSelected"
                     ScoreOverlay="@scoreOverlay"
                     SecondaryScoreOverlay="@secondaryScoreOverlay"
                     ScoreCursor="@scoreCursorState"
                     SecondaryScoreCursor="@secondaryScoreCursorState"
                     PrimaryScoreRangeLabel="@PrimaryScoreRangeLabel"
                     SecondaryScoreRangeLabel="@SecondaryScoreRangeLabel"
                     PrimaryScoreRowStatus="@PrimaryScoreRowStatus"
                     SecondaryScoreRowStatus="@SecondaryScoreRowStatus"
                     ActiveKeyboardMidiNumbers="@activeKeyboardMidiNumbers"
                     NextKeyboardMidiNumbers="@nextKeyboardMidiNumbers"
                     PointerNoteOn="HandlePointerNoteOnAsync"
                     PointerNoteOff="HandlePointerNoteOffAsync">
            <PracticeContent>
                <div class="analysis-controls" role="group" aria-label="Practice">
                    <span>Practice</span>
                    <button class="button-quiet"
                            type="button"
                            aria-controls="sight-reading-exercise-panel"
                            aria-pressed="@(showSightReadingExercisePanel ? "true" : "false")"
                            @onclick="ToggleSightReadingExercisePanel">
                        @(showSightReadingExercisePanel ? "Hide note reading exercise" : "Show note reading exercise")
                    </button>
                    <button class="button-quiet"
                            type="button"
                            aria-controls="sight-reading-progress-panel"
                            aria-pressed="@(showSightReadingProgressPanel ? "true" : "false")"
                            @onclick="ToggleSightReadingProgressPanel">
                        @(showSightReadingProgressPanel ? "Hide progress" : "Show progress")
                    </button>
                </div>

                @if (showSightReadingExercisePanel)
                {
                    <div id="sight-reading-exercise-panel">
                        <SightReadingExercisePanel Presentation="@ExercisePresentation"
                                                   OnAction="HandleSightReadingExerciseActionAsync"
                                                   Hide="ToggleSightReadingExercisePanel" />
                    </div>
                }

                @if (showSightReadingProgressPanel)
                {
                    <div id="sight-reading-progress-panel">
                        <SightReadingHistoryPanel RecentSessions="@RecentSightReadingSessions"
                                                   WeakestPitches="@sightReadingHistory.ComputeMasteryWeakestFirst()"
                                                   InsufficientDataPitchCount="@InsufficientMasteryDataPitchCount"
                                                   Insights="@sightReadingInsights"
                                                   Ladder="@sightReadingLadder"
                                                   ClearHistory="ClearSightReadingHistoryAsync"
                                                   Hide="ToggleSightReadingProgressPanel" />
                    </div>
                }
            </PracticeContent>
        </PianoCanvas>
    </section>
</main>

@code {
    private const string TestNoteId = "test-note";
    private const int MinimumMeterNumerator = 1;
    private const int MaximumMeterNumerator = 12;
    private const int MinimumVisibleMeasureCount = 1;
    // The fixed per-notehead clearance constants (GrandStaffSceneBuilder.MapScoreNotationBeatToX)
    // only hit a hard, arithmetic zero-width collapse at count = 38, but a note-dense measure (many
    // notes/chords packed into one measure, e.g. a stepwise scale run) runs out of usable room well
    // before that: screenshot-verified against a real dense score, 20 already renders as an
    // illegible blob. 12 was chosen from that same visual check, not the arithmetic alone.
    private const int MaximumVisibleMeasureCount = 12;
    private const int MinimumTempoBeatsPerMinute = 30;
    private const int MaximumTempoBeatsPerMinute = 300;
    private const int StrictToleranceMilliseconds = 30;
    private const int NormalToleranceMilliseconds = 60;
    private const int RelaxedToleranceMilliseconds = 100;
    private static readonly Pitch TestPitch = new(NoteLetter.A, 0, 4);
    private static readonly TimeSpan BrowserSchedulingLead = TimeSpan.FromMilliseconds(50);
    private static readonly TimeSpan CanvasRefreshInterval = TimeSpan.FromMilliseconds(16);
    private static readonly TimeSpan AutoNextRefreshInterval = TimeSpan.FromMilliseconds(250);

    private readonly NoteTimeline noteTimeline = new();
    private readonly TempoFeedbackTracker tempoFeedbackTracker = new();
    private readonly BrowserKeyboardState keyboardState;
    private readonly BrowserNoteInputState noteInputState;
    private readonly BrowserMidiInputState midiInputState;
    private readonly BrowserComputerPianoState computerPianoState;
    private readonly GrandStaffSceneCache upperGrandStaffSceneCache = new();
    private readonly GrandStaffSceneCache lowerGrandStaffSceneCache = new();
    private readonly NoteReadingSession noteReadingSession = new();
    private readonly SightReadingExerciseCoordinator sightReadingExerciseCoordinator;
    private BrowserSightReadingHistoryStore sightReadingHistoryStore = null!;
    private SightReadingHistory sightReadingHistory = SightReadingHistory.Empty;
    private SightReadingInsightReport sightReadingInsights = SightReadingInsights.Build(SightReadingHistory.Empty);
    private IReadOnlyList<NoteMastery> sightReadingWeakNotes = [];
    private LevelProgressionReport sightReadingLadder = LevelProgression.Evaluate(SightReadingHistory.Empty);
    private readonly HashSet<PerformedNote> wrongScoreInputNotes = new(ReferenceEqualityComparer.Instance);
    private ElementReference playSurface;
    private AudioClockAnchor? audioClockAnchor;
    private IJSObjectReference? keyboardModule;
    private IJSObjectReference? midiModule;
    private DotNetObjectReference<Piano>? inputReference;
    private IPianoCanvasScene canvasScene = GrandStaffSceneBuilder.Build([], TimeSpan.Zero, selectedOctave: 4);
    private IPianoCanvasScene? secondaryCanvasScene;
    private GrandStaffScoreOverlay? scoreOverlay;
    private GrandStaffScoreOverlay? secondaryScoreOverlay;
    private ScoreCursorPlaybackState? scoreCursorState;
    private ScoreCursorPlaybackState? secondaryScoreCursorState;
    private IReadOnlySet<int> activeKeyboardMidiNumbers = new HashSet<int>();
    private IReadOnlySet<int> nextKeyboardMidiNumbers = new HashSet<int>();
    private IReadOnlyList<PerformedNote> scheduledKeyboardNotes = [];
    private Score? importedScore;
    private Score? loadedScore;
    private Score? selectedScore;
    private Guid? loadedSavedScoreId;
    private int selectedFirstMeasure;
    private int selectedLastMeasure;
    private ScoreGrandStaffWindowPair.State? scoreWindowPair;
    private ScoreNoteAddress? selectedScoreNoteAddress;
    private readonly AsyncTicker playbackTicker = new();
    private BrowserPracticeCoordinator practiceCoordinator = null!;
    private ExercisePlayAlongController playAlongController = null!;
    private readonly AsyncTicker practiceTicker = new();
    private readonly AsyncTicker visualizationTicker = new();
    private readonly AsyncTicker sightReadingCountInTicker = new();
    private readonly AsyncTicker autoNextTicker = new();
    private string audioStatus = "Starting audio...";
    private string midiStatus = string.Empty;
    private IReadOnlyList<string> midiInputNames = [];
    private string? midiOutputName;
    private BrowserSoundSource soundSource = BrowserSoundSource.Piano;
    private bool isSoundSourceChanging;
    private bool isMidiConnecting;
    private bool testNoteIsActive;
    private bool showPianoRoll;
    private bool showSightReadingExercisePanel;
    private bool showSightReadingProgressPanel;
    private bool showNoteLabels = true;
    private bool showFingerings = true;
    private bool showNextKeyHints;
    private int visibleMeasureCount = GrandStaffLayout.DefaultVisibleMeasureCount;
    private bool isFingeringEditing;
    private bool isFingeringGenerating;
    private NoteReadingMode idleNoteReadingMode = NoteReadingMode.PitchAndOrder;
    private TimeSignature displayTimeSignature = new(4, new NoteValue(4));
    private Tempo displayTempo = new(120);
    private (TimeSignature TimeSignature, Tempo Tempo)? timingBeforeSightReadingExercise;
    private TimeSpan onTimeTolerance = TimeSpan.FromMilliseconds(NormalToleranceMilliseconds);

    private SightReadingExercisePresentation ExercisePresentation => new()
    {
        SelectedStaff = sightReadingExerciseCoordinator.Staff,
        PresetId = sightReadingExerciseCoordinator.PresetId,
        PromptCountOption = sightReadingExerciseCoordinator.PromptCountOption,
        Motion = sightReadingExerciseCoordinator.EffectiveMotion,
        IntervalSteps = sightReadingExerciseCoordinator.IntervalSteps,
        IsMotionAvailable = sightReadingExerciseCoordinator.IsMotionAvailable,
        IsGrandStaff = sightReadingExerciseCoordinator.IsGrandStaff,
        IsHandsTogether = sightReadingExerciseCoordinator.EffectiveHandsTogether,
        IsHandsTogetherAvailable = sightReadingExerciseCoordinator.IsHandsTogetherAvailable,
        RhythmPreset = sightReadingExerciseCoordinator.EffectiveRhythmPreset,
        Mode = sightReadingExerciseCoordinator.Mode,
        RunMode = sightReadingExerciseCoordinator.RunMode,
        TempoPulsesPerMinute = sightReadingExerciseCoordinator.TempoPulsesPerMinute,
        IsRhythmPresetLocked = sightReadingExerciseCoordinator.IsRhythmPresetLocked,
        Pacing = sightReadingExerciseCoordinator.EffectivePacing,
        IsPacingAvailable = sightReadingExerciseCoordinator.UsesCountIn,
        IsPitchSetupIgnored = sightReadingExerciseCoordinator.IsPitchSetupIgnored,
        RevealNoteNamesWhileActive = sightReadingExerciseCoordinator.RevealNoteNamesWhileActive,
        RevealFingeringWhileActive = sightReadingExerciseCoordinator.RevealFingeringWhileActive,
