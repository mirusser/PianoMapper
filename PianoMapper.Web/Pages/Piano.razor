    [JSInvokable]
    public Task HandleKeyDownAsync(BrowserKeyboardEvent keyboardEvent)
    {
        TimeSpan eventTime = MapEventTime(keyboardEvent.EventTimestampMilliseconds);

        // The computer-piano toggle takes priority over control shortcuts for any code it maps (e.g. KeyC/KeyV/KeyM
        // are both shortcuts and piano notes) — that's the documented tradeoff of opting in. When disabled, or for
        // a code it doesn't map, this returns an unhandled command and falls through to the shortcut table below,
        // so existing browser shortcuts are unaffected while the computer piano is off.
        BrowserInputCommand pianoCommand = computerPianoState.HandleKeyDown(
            keyboardEvent.Code,
            keyboardEvent.IsRepeat,
            keyboardState.CurrentOctave,
            eventTime);
        if (pianoCommand.IsHandled)
        {
            return ApplyInputCommandAsync(pianoCommand);
        }

        return ApplyInputCommandAsync(
            keyboardState.HandleKeyDown(keyboardEvent.Code, keyboardEvent.IsRepeat, eventTime));
    }

    [JSInvokable]
    public Task HandleKeyUpAsync(BrowserKeyboardEvent keyboardEvent) =>
        ApplyInputCommandAsync(
            computerPianoState.HandleKeyUp(keyboardEvent.Code, MapEventTime(keyboardEvent.EventTimestampMilliseconds)));

    [JSInvokable]
    public Task HandleMidiMessageAsync(BrowserMidiEvent midiEvent) =>
        audioClockAnchor is null
            ? Task.CompletedTask
            : ApplyInputCommandAsync(
                midiInputState.Handle(
                    midiEvent,
                    MapEventTime(midiEvent.EventTimestampMilliseconds)));

    private Task HandlePointerNoteOnAsync(BrowserPointerNoteOnEvent pointerEvent)
    {
        if (audioClockAnchor is null || !Pitch.TryParse(pointerEvent.Pitch, out Pitch pitch))
        {
            return Task.CompletedTask;
        }

        return ApplyInputCommandAsync(noteInputState.StartNote(
            $"pointer:{pointerEvent.PointerId}",
            pitch,
            MapEventTime(pointerEvent.EventTimestampMilliseconds),
            WebAudioSession.DefaultNoteVelocity));
    }

    private Task HandlePointerNoteOffAsync(BrowserPointerNoteOffEvent pointerEvent) =>
        audioClockAnchor is null
            ? Task.CompletedTask
            : ApplyInputCommandAsync(noteInputState.ReleaseNote(
                $"pointer:{pointerEvent.PointerId}",
                MapEventTime(pointerEvent.EventTimestampMilliseconds)));

    [JSInvokable]
    public async Task HandleMidiConnectionChangedAsync(BrowserMidiConnectionStatus status)
    {
        UpdateMidiConnectionStatus(status);
        TimeSpan eventTime = AudioSession.IsInitialized
            ? await AudioSession.GetCurrentTimeAsync()
            : TimeSpan.Zero;
        await ApplyInputCommandAsync(midiInputState.ReleaseAll(eventTime));
        RefreshExternalMidiAudioStatus();

        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task HandleFocusLostAsync(double eventTimestampMilliseconds)
    {
        TimeSpan eventTime = MapEventTime(eventTimestampMilliseconds);

        // Release computer-piano keys first: HandleKeyUpAsync never fires for a key that's still physically held
        // when focus/visibility is lost (no keyup event follows), so without this, BrowserComputerPianoState's own
        // held-key bookkeeping would go stale — silently blocking that key from starting a new note the next time
        // it's pressed, even though the underlying note already stopped sounding.
        foreach (BrowserInputCommand command in computerPianoState.ReleaseAll(eventTime))
        {
            await ApplyInputCommandAsync(command);
        }

        // Pointer/touch note-off relies on the browser delivering pointerup/pointercancel, which isn't guaranteed
        // when the tab loses focus or visibility mid-touch (unlike a physical MIDI key, which sends its own
        // note-off independent of the browser). Release everything here as a safety net so no source can leave a
        // stuck note — releasing a MIDI note slightly early on focus loss is a smaller problem than one that never
        // stops sounding.
        await ApplyInputCommandAsync(noteInputState.ReleaseAll(eventTime));

        if (practiceCoordinator.IsActive)
        {
            await AbortPracticeAsync(eventTime);
        }

        if (sightReadingExerciseCoordinator.IsCountingIn)
        {
            await sightReadingCountInTicker.StopAsync();
            sightReadingExerciseCoordinator.CancelCountIn();
            if (Metronome.IsRunning)
            {
                await StopMetronomeAsync();
            }

            audioStatus = "Rhythm count-in cancelled (focus lost). Generate a new exercise to try again.";
            await InvokeAsync(StateHasChanged);
        }
        else if (ExerciseClick.IsRunning)
        {
            await StopExerciseClickAsync();
            audioStatus = "Click stopped (focus lost). Retry the exercise to play with the click again.";
            await InvokeAsync(StateHasChanged);
        }

        // Nobody is watching the countdown, and a timed exercise generated now would count in with nobody there.
        if (sightReadingExerciseCoordinator.AutoNextRemaining is not null)
        {
            sightReadingExerciseCoordinator.CancelAutoNext();
            audioStatus = "Next exercise cancelled (focus lost). Choose Next exercise when you are back.";
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await visualizationTicker.StopAsync();
        await sightReadingCountInTicker.StopAsync();
        await autoNextTicker.StopAsync();
        await AbortPracticeAsync(updateStatus: false);
        await StopScorePlaybackAsync();
        if (Metronome.IsRunning)
        {
            await StopMetronomeAsync();
        }

        if (keyboardModule is not null)
        {
            await keyboardModule.InvokeVoidAsync("dispose");
            await keyboardModule.DisposeAsync();
        }

        if (midiModule is not null)
        {
            await midiModule.InvokeVoidAsync("dispose");
            await midiModule.DisposeAsync();
        }

        inputReference?.Dispose();
    }

    private TimeSpan GetAnchorTime() =>
        TimeSpan.FromSeconds(audioClockAnchor?.AudioTimeSeconds ?? 0);

    private TimeSpan MapEventTime(double eventTimestampMilliseconds) =>
        BrowserAudioClock.MapEventTimestamp(audioClockAnchor!, eventTimestampMilliseconds);

    private async Task AttachKeyboardAsync()
    {
        keyboardModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/keyboard.js");
        inputReference ??= DotNetObjectReference.Create(this);

        // Always include the computer-piano codes in the browser's "prevent default"/handled set, even though the
        // toggle may currently be off — BrowserComputerPianoState.HandleKeyDown/Up simply no-op for those codes
        // while disabled, so there's no observable difference, and it avoids having to re-attach with a different
        // code list whenever the toggle changes at runtime.
        string[] handledCodes = BrowserKeyBindings.HandledCodes
            .Concat(BrowserComputerPianoBindings.HandledCodes)
            .Distinct(StringComparer.Ordinal)
            .ToArray();

        await keyboardModule.InvokeVoidAsync(
            "attach",
            playSurface,
            inputReference,
            handledCodes);
    }

    private void UpdateMidiConnectionStatus(BrowserMidiConnectionStatus status)
    {
        midiInputNames = status.InputNames;
        midiOutputName = status.OutputName;
        midiStatus = GetMidiStatusMessage(status);
    }

    // Empty when the Audio card's "MIDI input … · MIDI output …" summary already says it all (piano found or not),
    // so only the messages that explain why something is unavailable are shown.
    internal static string GetMidiStatusMessage(BrowserMidiConnectionStatus status)
    {
        ArgumentNullException.ThrowIfNull(status);

        return !status.IsSupported
            ? "Web MIDI is not supported by this browser. Use a Web MIDI-capable browser on localhost or HTTPS."
            : status.IsPermissionRequired
                ? "MIDI permission is required. Select Connect MIDI piano and allow access."
                : string.Empty;
    }

    private void RefreshExternalMidiAudioStatus()
    {
        if (!AudioSession.IsInitialized || soundSource != BrowserSoundSource.ExternalMidi)
        {
            return;
        }

        audioStatus = midiOutputName is null
            ? "FP-10 MIDI output disconnected. Reconnect it or select a PC sound."
            : AudioReadyStatus;
    }

    private async Task ApplyInputCommandAsync(BrowserInputCommand command)
    {
        switch (command.Kind)
        {
            case BrowserInputCommandKind.None:
                return;
            case BrowserInputCommandKind.NoteOn:
                await HandleNoteOnCommandAsync(command);
                break;
            case BrowserInputCommandKind.NoteOff:
                await HandleNoteOffCommandAsync(command);
                break;
            case BrowserInputCommandKind.Clear:
                await HandleClearCommandAsync(command);
                break;
            case BrowserInputCommandKind.ReleaseHeldNotes:
                await HandleReleaseHeldNotesCommandAsync(command);
                break;
            case BrowserInputCommandKind.OctaveChanged:
                audioStatus = $"Octave {keyboardState.CurrentOctave} selected.";
                RefreshCanvasScene(command.EventTime);
                break;
            case BrowserInputCommandKind.PreviousMeasures:
                ShowPreviousMeasures();
                break;
            case BrowserInputCommandKind.NextMeasures:
                ShowNextMeasures();
                break;
            case BrowserInputCommandKind.StartScorePlayback:
                await StartScorePlaybackAsync();
                break;
            case BrowserInputCommandKind.StartPractice:
                await StartPracticeAsync();
                break;
            case BrowserInputCommandKind.ToggleView:
                await SetViewAsync(command.EventTime);
                break;
            case BrowserInputCommandKind.PlayRandomMeasure:
                await PlayRandomMeasureAsync();
                break;
            default:
                throw new InvalidOperationException($"Unsupported browser input command: {command.Kind}.");
        }

        if (command.Kind is BrowserInputCommandKind.NoteOn or
            BrowserInputCommandKind.NoteOff or
            BrowserInputCommandKind.Clear or
            BrowserInputCommandKind.ReleaseHeldNotes)
        {
            RefreshCanvasScene(command.EventTime);
            EnsureVisualizationRefresh();
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleNoteOnCommandAsync(BrowserInputCommand command)
    {
        await AudioSession.StartNoteAsync(
            command.NoteId!,
            command.Pitch!.Value,
            command.EventTime,
            velocity: command.Velocity);
        tempoFeedbackTracker.Record(command.EventTime, Metronome.Grid, onTimeTolerance);
        if (IsIdleNoteCheckingActive)
        {
            NoteReadingSession.CheckResult result = noteReadingSession.Check(
                command.Pitch.Value,
                command.EventTime);
            if (!result.IsCorrect && !result.IsComplete && command.Note is { } wrongNote)
            {
                wrongScoreInputNotes.Add(wrongNote);
            }

            audioStatus = GetNoteReadingStatus(command.Pitch.Value, result);
            await SaveSightReadingHistoryIfCompletedAsync();
        }
        else
        {
            audioStatus = $"Playing {command.Pitch}.";
        }
    }

    private async Task HandleNoteOffCommandAsync(BrowserInputCommand command)
    {
        await AudioSession.StopNoteAsync(command.NoteId!, command.EventTime);
        if (IsIdleNoteCheckingActive && command.Pitch is { } releasedPitch)
        {
            NoteReadingSession.ReleaseResult result = noteReadingSession.Release(
                releasedPitch,
                command.EventTime);
            if (result.WasTracked && result.Verdict.HasValue)
            {
                audioStatus = GetNoteReadingReleaseStatus(result);
            }

            await SaveSightReadingHistoryIfCompletedAsync();
        }

        if (command.Note is { } releasedNote)
        {
            wrongScoreInputNotes.Remove(releasedNote);
        }

        if (!IsIdleNoteCheckingActive)
        {
            audioStatus = "Audio is ready.";
        }
    }

    private async Task HandleClearCommandAsync(BrowserInputCommand command)
    {
        midiInputState.Clear(command.EventTime);
        noteReadingSession.ReleaseAll(command.EventTime);
        wrongScoreInputNotes.Clear();
        await StopScorePlaybackAsync();
        bool metronomeWasRunning = Metronome.IsRunning;
        if (metronomeWasRunning)
        {
            await StopMetronomeAsync();
        }
        else
        {
            tempoFeedbackTracker.Reset();
        }

        bool practiceWasActive = practiceCoordinator.State != PracticeSessionState.Idle;
        await practiceTicker.StopAsync();
        if (practiceWasActive)
        {
            await practiceCoordinator.AbortAsync();
        }

        await AudioSession.ClearAsync(command.EventTime);
        testNoteIsActive = false;
        audioStatus = metronomeWasRunning
            ? "Metronome off."
            : practiceWasActive
                ? "Practice aborted."
                : "All notes cleared.";
    }

    private async Task HandleReleaseHeldNotesCommandAsync(BrowserInputCommand command)
    {
        noteReadingSession.ReleaseAll(command.EventTime);
        wrongScoreInputNotes.Clear();
        await AudioSession.ClearAsync(command.EventTime);
        testNoteIsActive = false;
        if (!ScorePlaybackSession.IsActive)
        {
            audioStatus = "Held notes released.";
        }
    }

    private async Task<bool> TickScorePlaybackAsync(CancellationToken cancellationToken)
    {
        if (selectedScore is null)
        {
            return false;
        }

        TimeSpan currentTime = await AudioSession.GetCurrentTimeAsync(cancellationToken);

        double? cursorBeats = ScorePlaybackSession.GetCursorBeats(currentTime);
        bool scoreWindowChanged = !showPianoRoll && cursorBeats.HasValue
            && UpdateScoreWindowPairFromCursor(cursorBeats.Value);

        if (showPianoRoll || scoreWindowChanged)
        {
            RefreshCanvasScene(currentTime);
        }
        else
        {
            RefreshKeyboardState(currentTime);
        }

        await InvokeAsync(StateHasChanged);

        if (!ScorePlaybackSession.IsActive)
        {
            scoreCursorState = null;
            secondaryScoreCursorState = null;
            RefreshCanvasScene(currentTime);
            audioStatus = "Audio is ready.";
            EnsureVisualizationRefresh();
            await InvokeAsync(StateHasChanged);
            return false;
        }

        return true;
    }

    private async Task<bool> TickPracticeAsync(CancellationToken cancellationToken)
    {
        if (selectedScore is null)
        {
            return false;
        }

        await practiceCoordinator.UpdateAsync(cancellationToken);
        double? cursorBeats = practiceCoordinator.State is
            PracticeSessionState.Running or PracticeSessionState.Finished
                ? practiceCoordinator.CursorBeats
                : null;
        RefreshCanvasScene(
            practiceCoordinator.CurrentTime,
            cursorBeats,
            practiceCoordinator.GetVisibleVerdicts());
        audioStatus = practiceCoordinator.State switch
        {
            PracticeSessionState.CountingIn => "Practice count-in.",
            PracticeSessionState.Running => "Practice in progress.",
            PracticeSessionState.Finished => "Practice finished.",
            _ => audioStatus,
        };
        await InvokeAsync(StateHasChanged);

        if (practiceCoordinator.State == PracticeSessionState.Finished)
        {
            EnsureVisualizationRefresh();
            return false;
        }

        return true;
    }

    private async Task AbortPracticeAsync(TimeSpan? eventTime = null, bool updateStatus = true)
    {
        await practiceTicker.StopAsync();
        if (practiceCoordinator.State == PracticeSessionState.Idle)
        {
            return;
        }

        bool wasSightReadingPlayAlong = sightReadingExerciseCoordinator.IsActive &&
            sightReadingExerciseCoordinator.RunPacing == ExercisePacing.PlayAlong;
        await StopExerciseClickAsync();
        await practiceCoordinator.AbortAsync();
        ResetNoteReadingSession();
        if (AudioSession.IsInitialized)
        {
            TimeSpan releaseTime = eventTime ?? await AudioSession.GetCurrentTimeAsync();
            midiInputState.Clear(releaseTime);
            await AudioSession.ClearAsync(releaseTime);
        }

        if (NotationScore is not null)
        {
            RefreshCanvasScene(eventTime ?? GetAnchorTime());
        }

        if (updateStatus)
        {
            audioStatus = wasSightReadingPlayAlong
                ? "Play-along stopped. Retry to try again."
                : "Practice aborted.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SetViewAsync(TimeSpan currentTime)
    {
        if (IsSightReadingExerciseActive)
        {
            return;
        }

        showPianoRoll = !showPianoRoll;
        if (showPianoRoll)
        {
            ExitFingeringEditMode();
        }

        RefreshCanvasScene(currentTime);
        if (ShouldContinueVisualizationRefresh(
            showPianoRoll,
            NotationScore is not null,
            canvasScene,
            midiInputState.ActiveNoteCount,
            scheduledKeyboardNotes.Count > 0))
        {
            EnsureVisualizationRefresh();
        }
        else
        {
            await visualizationTicker.StopAsync();
        }
    }

    private void RefreshCanvasScene(
        TimeSpan currentTime,
        double? cursorBeats = null,
        IReadOnlyDictionary<ScoreNote, Verdict>? verdicts = null)
    {
        RefreshKeyboardState(currentTime);

        if (showPianoRoll)
        {
            var notes = noteTimeline.Snapshot(currentTime)
                .Concat(ScorePlaybackSession.GetStartedNotes(currentTime))
                .ToArray();
            canvasScene = PianoRollSceneBuilder.Build(notes, currentTime);
            secondaryCanvasScene = null;
            scoreOverlay = null;
            secondaryScoreOverlay = null;
            UpdateScoreCursorStates();
            return;
        }

        Score? notationScore = NotationScore;
        if (notationScore is null)
        {
            canvasScene = GrandStaffSceneBuilder.Build(
                noteTimeline.Snapshot(currentTime),
                currentTime,
                displayTimeSignature,
                displayTempo,
                keyboardState.CurrentOctave,
                showNoteLabels);
            secondaryCanvasScene = null;
            scoreOverlay = null;
            secondaryScoreOverlay = null;
            UpdateScoreCursorStates();
            return;
        }

        if (cursorBeats.HasValue)
        {
            UpdateScoreWindowPairFromCursor(cursorBeats.Value);
        }
        else if (scoreWindowPair is null)
        {
            ResetScoreWindowPair();
        }

        bool isIdleNoteCheckingActive = IsIdleNoteCheckingActive;
        double? effectiveCursorBeats = cursorBeats ?? (isIdleNoteCheckingActive
            ? noteReadingSession.CurrentOnsetBeats
            : null);
        if (!cursorBeats.HasValue && effectiveCursorBeats.HasValue)
        {
            UpdateScoreWindowPairFromCursor(effectiveCursorBeats.Value);
        }

        // A finished play-along run keeps showing the practice engine's verdicts in review; a pitch-gated run shows
        // the session's.
        bool isPlayAlongReview = sightReadingExerciseCoordinator.Phase == SightReadingExercisePhase.Review &&
            sightReadingExerciseCoordinator.RunPacing == ExercisePacing.PlayAlong;
        IReadOnlyDictionary<ScoreNote, Verdict>? effectiveVerdicts = verdicts ??
            (isIdleNoteCheckingActive
                ? noteReadingSession.Verdicts
                : isPlayAlongReview ? practiceCoordinator.GetVisibleVerdicts() : null);
        if (isPlayAlongReview && effectiveVerdicts is not null)
        {
            // A clean note is green here too, as in Wait for me (the engine's own verdicts also judge holds).
            effectiveVerdicts = sightReadingExerciseCoordinator.BuildPlayAlongReviewVerdicts(effectiveVerdicts);
        }
        IReadOnlySet<ScoreNote>? expectedNotes = isIdleNoteCheckingActive
            ? noteReadingSession.ExpectedNotes
            : null;

        double? performedNoteBeats = effectiveCursorBeats;
        if (!performedNoteBeats.HasValue && ScorePlaybackSession.IsActive)
        {
            performedNoteBeats = ScorePlaybackSession.GetCursorBeats(currentTime);
        }

        // Rests and ties are drawn for generated exercise scores only; imported scores keep their long-standing
        // rendering until drawing them is checked against real saved scores.
        bool drawRests = sightReadingExerciseCoordinator.Score is not null;
        bool drawTies = drawRests;
        // Review marks are the exercise's own, drawn once it has finished (null while it is active or for an imported
        // score), and never mixed into the live verdict colors above.
        IReadOnlyDictionary<ScoreNote, ReviewMark>? reviewMarks = sightReadingExerciseCoordinator.BuildReviewMarks();
        var performedNotes = noteTimeline.Snapshot(currentTime);
        IReadOnlySet<PerformedNote>? performedNotesToInclude = isIdleNoteCheckingActive
            ? wrongScoreInputNotes
            : null;
        int upperFirstMeasure = scoreWindowPair?.UpperFirstMeasure ?? 0;
        IReadOnlyList<PerformedNote> upperPerformedNotes = scoreWindowPair is { } windowPair
            ? GetPerformedNotesForScoreRow(
                performedNotes,
                windowPair,
                ScoreGrandStaffWindowPair.PhysicalRow.Upper,
                performedNotesToInclude)
            : performedNotesToInclude is null
                ? performedNotes
                : performedNotes.Where(performedNotesToInclude.Contains).ToArray();
        double? overlayCursorBeats = practiceCoordinator.State == PracticeSessionState.Running
            ? null
            : effectiveCursorBeats;
        GrandStaffScoreRenderState upperRenderState = upperGrandStaffSceneCache.BuildScoreRenderState(
            notationScore,
            upperFirstMeasure,
            overlayCursorBeats,
            effectiveVerdicts,
            upperPerformedNotes,
            performedNoteBeats,
            EffectiveShowNoteLabels,
            EffectiveShowFingerings,
            expectedNotes,
            visibleMeasureCount,
            drawRests,
            drawTies,
            reviewMarks);
        canvasScene = upperRenderState.Scene;
        scoreOverlay = upperRenderState.Overlay;
        GrandStaffStaticScoreParts? lowerStaticParts = null;
        if (scoreWindowPair?.LowerFirstMeasure is { } lowerFirstMeasure)
        {
            GrandStaffScoreRenderState lowerRenderState = lowerGrandStaffSceneCache.BuildScoreRenderState(
                notationScore,
                lowerFirstMeasure,
                overlayCursorBeats,
                effectiveVerdicts,
                GetPerformedNotesForScoreRow(
                    performedNotes,
                    scoreWindowPair.Value,
                    ScoreGrandStaffWindowPair.PhysicalRow.Lower,
                    performedNotesToInclude),
                performedNoteBeats,
                EffectiveShowNoteLabels,
                EffectiveShowFingerings,
                expectedNotes,
                visibleMeasureCount,
                drawRests,
                drawTies,
                reviewMarks);
            secondaryCanvasScene = lowerRenderState.Scene;
            secondaryScoreOverlay = lowerRenderState.Overlay;
            lowerStaticParts = lowerRenderState.StaticParts;
        }
        else
        {
            secondaryCanvasScene = null;
            secondaryScoreOverlay = null;
        }

        UpdateScoreCursorStates(notationScore, upperRenderState.StaticParts, lowerStaticParts);
    }

    internal static IReadOnlyList<PerformedNote> GetPerformedNotesForScoreRow(
        IReadOnlyList<PerformedNote> performedNotes,
        ScoreGrandStaffWindowPair.State windowPair,
        ScoreGrandStaffWindowPair.PhysicalRow renderedRow,
        IReadOnlySet<PerformedNote>? performedNotesToInclude = null)
    {
        ArgumentNullException.ThrowIfNull(performedNotes);
        if (windowPair.ActiveRow != renderedRow)
        {
            return [];
        }

        return performedNotesToInclude is null
            ? performedNotes
            : performedNotes.Where(performedNotesToInclude.Contains).ToArray();
    }

    private void ResetNoteReadingSession()
    {
        noteReadingSession.Reset(
            IsNoteCheckingEnabled ? NotationScore : null,
            ActiveNoteReadingMode,
            onTimeTolerance);
        wrongScoreInputNotes.Clear();
    }

    private string GetNoteReadingStatus(
        Pitch pitch,
        NoteReadingSession.CheckResult result)
    {
        bool isSightReading = IsSightReadingExerciseActive;
        if (!result.IsCorrect)
        {
            if (isSightReading)
            {
                if (result.IsComplete)
                {
                    return "Note reading exercise complete. Generate a new exercise or retry these notes.";
                }

                string tryAgain = $"{pitch} is not the highlighted exercise note. Try again.";
                return sightReadingExerciseCoordinator.GetCoachHint() is { } coachHint
                    ? $"{tryAgain} {ExerciseCoachHintText.Describe(coachHint)}"
                    : tryAgain;
            }

            return result.IsComplete
                ? "Idle note check complete."
                : $"{pitch} is not the highlighted note. Try again.";
        }

        // Below this point every branch was previously reachable only for idle checking, because generated
        // exercises were always PitchAndOrder mode. Task 16 lets a generated exercise use Hold/Rhythm mode too, so
        // these branches (already correct and shared by idle checking) now also apply to sight-reading exercises —
        // their wording is generic enough ("the highlighted notes"/"chord notes") to read correctly either way.
        if (ActiveNoteReadingMode.GetGradedAxes().HasFlag(GradedAxes.Onset) &&
            result.Verdict is Verdict.Early or Verdict.Late)
        {
            return $"Right pitch, but {result.Verdict.ToString()!.ToLowerInvariant()}. Continue with the highlighted notes.";
        }

        if (ActiveNoteReadingMode.GetGradedAxes().HasFlag(GradedAxes.Duration))
        {
            if (result.IsComplete)
            {
                return isSightReading ? "Correct. Note reading exercise complete." : "Correct. Idle note check complete.";
            }

            return result.DidAdvance
                ? "Correct attack. Keep the highlighted held notes sounding for their written durations."
                : "Correct attack. Continue with the highlighted chord notes.";
        }

        if (isSightReading)
        {
            return result.IsComplete
                ? "Correct. Note reading exercise complete."
                : "Correct. Play the next highlighted note.";
        }

        if (result.IsComplete)
        {
            return "Correct. Idle note check complete.";
        }

        return result.DidAdvance
            ? "Correct. The next score note is highlighted."
            : "Correct. Continue with the highlighted chord notes.";
    }

    private static string GetNoteReadingReleaseStatus(NoteReadingSession.ReleaseResult result)
    {
        var feedback = new List<string>();
        if (result.OnsetVerdict is Verdict.Early or Verdict.Late)
        {
            feedback.Add($"The pitch was started {result.OnsetVerdict.ToString()!.ToLowerInvariant()}.");
        }

        string durationStatus = result.DurationVerdict switch
        {
            Verdict.Correct when feedback.Count == 0 => "Correct hold duration.",
            Verdict.TooShort => "That note was released too soon.",
            Verdict.TooLong => "That note was held too long.",
            _ => string.Empty,
        };
        if (durationStatus.Length > 0)
        {
            feedback.Add(durationStatus);
        }

        string status = string.Join(' ', feedback);
        return result.IsComplete ? $"{status} Idle note check complete." : status;
    }

    private void RefreshKeyboardState(TimeSpan currentTime)
    {
        if (scheduledKeyboardNotes.Count > 0 && scheduledKeyboardNotes.All(note => note.ReleaseTime <= currentTime))
        {
            scheduledKeyboardNotes = [];
        }

        activeKeyboardMidiNumbers = GetActiveKeyboardMidiNumbers(
            noteTimeline.Snapshot(currentTime),
            ScorePlaybackSession.GetStartedNotes(currentTime).Concat(scheduledKeyboardNotes),
            currentTime,
            testNoteIsActive ? TestPitch : null);
        nextKeyboardMidiNumbers = GetNextKeyboardMidiNumbers(
            EffectiveShowNextKeyHints,
            practiceCoordinator.IsActive,
            practiceCoordinator.GetNextPitches(),
            IsIdleNoteCheckingActive,
            noteReadingSession.ExpectedNotes);
    }

    internal static IReadOnlySet<int> GetNextKeyboardMidiNumbers(
        bool isEnabled,
        bool isPracticeActive,
        IEnumerable<Pitch> practiceNextPitches,
        bool isNoteCheckingActive,
        IEnumerable<ScoreNote> expectedNotes)
    {
        ArgumentNullException.ThrowIfNull(practiceNextPitches);
        ArgumentNullException.ThrowIfNull(expectedNotes);

        if (!isEnabled)
        {
            return new HashSet<int>();
        }

        if (isPracticeActive)
        {
            return practiceNextPitches.Select(pitch => pitch.MidiNumber).ToHashSet();
        }

        return isNoteCheckingActive
            ? expectedNotes.Select(note => note.Pitch.MidiNumber).ToHashSet()
            : new HashSet<int>();
    }

    internal static IReadOnlySet<int> GetActiveKeyboardMidiNumbers(
        IEnumerable<PerformedNote> liveNotes,
        IEnumerable<PerformedNote> scoreNotes,
        TimeSpan currentTime,
        Pitch? testPitch)
    {
        ArgumentNullException.ThrowIfNull(liveNotes);
        ArgumentNullException.ThrowIfNull(scoreNotes);

        var activeMidiNumbers = liveNotes
            .Concat(scoreNotes)
            .Where(note =>
                note.StartTime <= currentTime &&
                (!note.ReleaseTime.HasValue || note.ReleaseTime.Value > currentTime))
            .Select(note => note.Pitch.MidiNumber)
            .ToHashSet();
        if (testPitch.HasValue)
        {
            activeMidiNumbers.Add(testPitch.Value.MidiNumber);
        }

        return activeMidiNumbers;
    }

    internal static bool ShouldContinueVisualizationRefresh(
        bool showPianoRoll,
        bool hasLoadedScore,
        IPianoCanvasScene scene,
        int activeNoteCount,
        bool hasScheduledKeyboardNotes = false)
    {
        if (hasScheduledKeyboardNotes)
        {
            return true;
        }

        if (!showPianoRoll && hasLoadedScore)
        {
            return false;
        }

        if (!showPianoRoll)
        {
            return true;
        }

        return activeNoteCount > 0 || scene switch
        {
            GrandStaffScene { Notes.Count: > 0 } => true,
            PianoRollScene { Bars.Count: > 0 } => true,
            _ => false,
        };
    }

    private void EnsureVisualizationRefresh()
    {
        if (!AudioSession.IsInitialized ||
            ScorePlaybackSession.IsActive ||
            practiceCoordinator.IsActive ||
            visualizationTicker.IsRunning ||
            !ShouldContinueVisualizationRefresh(
                showPianoRoll,
                NotationScore is not null,
                canvasScene,
                midiInputState.ActiveNoteCount,
                scheduledKeyboardNotes.Count > 0))
        {
            return;
        }

        visualizationTicker.Start(TickVisualizationAsync, CanvasRefreshInterval);
    }

    private async Task<bool> TickVisualizationAsync(CancellationToken cancellationToken)
    {
        TimeSpan currentTime = await AudioSession.GetCurrentTimeAsync(cancellationToken);
        RefreshCanvasScene(currentTime);
        await InvokeAsync(StateHasChanged);
        return ShouldContinueVisualizationRefresh(
            showPianoRoll,
            NotationScore is not null,
            canvasScene,
            midiInputState.ActiveNoteCount,
            scheduledKeyboardNotes.Count > 0);
    }
}
