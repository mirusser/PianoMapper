<section class="control-card" aria-labelledby="sight-reading-history-heading">
    <div class="control-card-heading">
        <h2 id="sight-reading-history-heading">Progress</h2>
        <span>Local history and pitch mastery</span>
    </div>
    <section aria-labelledby="recent-sessions-heading">
        <h3 id="recent-sessions-heading">Recent sessions</h3>
        @if (RecentSessions.Count == 0)
        {
            <p class="control-note">No completed exercises yet. Finish one to start building history.</p>
        }
        else
        {
            <ul class="history-session-list">
                @foreach (SightReadingSessionSummary session in RecentSessions)
                {
                    <li>
                        @session.CompletedAt.ToLocalTime().ToString("g", CultureInfo.InvariantCulture) ·
                        @SightReadingLabels.DescribeSession(session) ·
                        @session.FirstTryCorrectCount of @session.PromptCount first-try correct ·
                        @if (SightReadingLabels.DescribeTimingBreakdown(session) is { } timingBreakdown)
                        {
                            <text>@timingBreakdown · </text>
                        }
                        @session.WrongAttemptCount mistake(s) ·
                        @session.ElapsedTime.ToString(@"m\:ss", CultureInfo.InvariantCulture) elapsed
                    </li>
                }
            </ul>
        }
    </section>
    <section aria-labelledby="ladder-heading">
        <h3 id="ladder-heading">Guided path</h3>
        <p class="control-note">A suggested order, not a lock: every exercise stays available.</p>
        <ol class="history-ladder-list">
            @foreach (LevelProgress progress in Ladder.Levels)
            {
                <li aria-current="@(progress.Status == LevelStatus.Recommended ? "step" : null)"
                    data-status="@progress.Status"
                    title="@SightReadingLabels.LevelStatus(progress.Status)">
                    @SightReadingLabels.DescribeLevelProgress(progress)
                </li>
            }
        </ol>
    </section>
    <section aria-labelledby="insights-heading">
        <h3 id="insights-heading">Weak spots and habits</h3>
        @if (!Insights.HasEnoughData)
        {
            <p class="control-note">Not enough attempts yet to rank individual pitches.</p>
        }
        else
        {
            @if (Insights.WeakSpots.Count > 0)
            {
                <ul class="history-mastery-list">
                    @foreach (NoteMastery spot in Insights.WeakSpots)
                    {
                        <li>
                            @spot.Pitch.ToString()@(spot.Staff is { } staff ? $" on {(staff == Staff.Bass ? "bass" : "treble")}" : string.Empty) —
                            @spot.AccuracyPercent.ToString("F0", CultureInfo.InvariantCulture)% first-try
                            (@spot.CorrectFirstTryCount of @spot.AttemptCount)
                        </li>
                    }
                </ul>
            }
            @foreach (ConfusionHabit habit in Insights.Habits)
            {
                <p class="control-note">Habit: @SightReadingInsightText.DescribeHabit(habit) (@habit.Count times).</p>
            }
            @if (Insights.Speed is { } speed)
            {
                <p class="control-note">
                    Self-paced speed: about @speed.MedianResponseTime.TotalSeconds.ToString("F1", CultureInfo.InvariantCulture) s per
                    note, @speed.NotesPerMinute.ToString("F0", CultureInfo.InvariantCulture) notes a minute.
                </p>
            }
            @if (Insights.Trend.Count > 0)
            {
                <p class="control-note">
                    Pitch accuracy, oldest to newest: @string.Join(" → ", Insights.Trend.Select(point => $"{point.PitchAccuracyPercent:F0}%"))
                    (@SightReadingInsightText.DescribeTrend(Insights.PitchTrend)).
                    @if (Insights.Trend.Any(point => point.TimingCleanPercent is not null))
                    {
                        <text>Timing clean: @string.Join(" → ", Insights.Trend.Where(point => point.TimingCleanPercent is not null).Select(point => $"{point.TimingCleanPercent:F0}%")).</text>
                    }
                </p>
            }
        }
    </section>
    <section aria-labelledby="pitch-mastery-heading">
        <h3 id="pitch-mastery-heading">Pitch mastery</h3>
        @if (WeakestPitches.Count == 0)
        {
            <p class="control-note">Not enough attempts yet to rank individual pitches.</p>
        }
        else
        {
            <ul class="history-mastery-list">
                @foreach (PitchMastery mastery in WeakestPitches)
                {
                    <li>
                        @mastery.Pitch.ToString() —
                        @mastery.AccuracyPercent.ToString("F0", CultureInfo.InvariantCulture)% first-try
                        (@mastery.CorrectFirstTryCount of @mastery.AttemptCount)
                    </li>
                }
            </ul>
        }
        @if (InsufficientDataPitchCount > 0)
        {
            <p class="control-note">
                @InsufficientDataPitchCount more pitch(es) need more attempts before mastery is meaningful.
            </p>
        }
    </section>
    <button class="button-quiet" type="button" @onclick="ClearHistoryAsync" disabled="@(RecentSessions.Count == 0)">
        Clear local history
    </button>
</section>

@code {
    [Parameter]
    public IReadOnlyList<SightReadingSessionSummary> RecentSessions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<PitchMastery> WeakestPitches { get; set; } = [];

    [Parameter]
    public int InsufficientDataPitchCount { get; set; }

    [Parameter]
    public LevelProgressionReport Ladder { get; set; } = LevelProgression.Evaluate(SightReadingHistory.Empty);

    [Parameter]
    public SightReadingInsightReport Insights { get; set; } = SightReadingInsights.Build(SightReadingHistory.Empty);

    [Parameter]
    public EventCallback ClearHistory { get; set; }

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    private async Task ClearHistoryAsync()
    {
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Clear your local note-reading history? This can't be undone and doesn't affect saved scores.");
        if (confirmed)
        {
            await ClearHistory.InvokeAsync();
        }
    }
}
