<div class="metronome-controls">
    <button class="metronome-toggle"
            type="button"
            @onclick="Toggle"
            disabled="@(!CanToggle)"
            aria-pressed="@IsRunning">
        @(IsRunning ? "Stop metronome" : "Start metronome")
    </button>
    @if (IsRunning)
    {
        <div class="metronome-beacon" data-metronome-pulse aria-hidden="true">
            <span class="metronome-beacon-label">Beat</span>
            <span class="metronome-beacon-count">
                <span data-metronome-beat-current>—</span><span class="metronome-beacon-separator">/</span><span data-metronome-beat-total>—</span>
            </span>
        </div>
        <TempoFeedback Feedback="Feedback" ShowPulse="false" />
        <span class="metronome-beat" data-metronome-beat>Beat —</span>
    }
</div>

@code {
    [Parameter]
    public bool IsRunning { get; set; }

    [Parameter]
    public bool CanToggle { get; set; }

    [Parameter]
    public TempoFeedbackTracker Feedback { get; set; } = null!;

    [Parameter]
    public EventCallback Toggle { get; set; }
}
