@inject ScoreFileImporter Importer

<div class="score-file-picker">
    <label for="score-file">MusicXML or score image (maximum 10 MiB)</label>
    <InputFile @key="inputGeneration"
               id="score-file"
               OnChange="SelectFileAsync"
               disabled="@isLoadingScore"
               accept=".mxl,.musicxml,.xml,.jpg,.jpeg,.png,application/vnd.recordare.musicxml,application/vnd.recordare.musicxml+xml,application/xml,text/xml,image/jpeg,image/png" />
    @if (isLoadingScore)
    {
        <ScoreLoadingIndicator />
    }
</div>
@if (!string.IsNullOrEmpty(status))
{
    <p role="status">@status</p>
}
<details class="learning-disclosure">
    <summary>Supported score files</summary>
    <p>
        MusicXML loads directly. JPEG and PNG sheet-music images are converted with the server's Audiveris
        optical music recognition engine; recognition may need correction in an external score editor.
    </p>
</details>

@code {
    internal const long MaximumFileSizeBytes = 10L * 1024 * 1024;

    private int inputGeneration;
    private string? status;
    private bool isLoadingScore;
    private bool wasLoaded;

    [Parameter]
    public EventCallback<Score> ScoreLoaded { get; set; }

    [Parameter]
    public bool HasLoadedScore { get; set; }

    protected override void OnParametersSet()
    {
        if (wasLoaded && !HasLoadedScore)
        {
            inputGeneration++;
            status = null;
        }

        wasLoaded = HasLoadedScore;
    }

    private async Task SelectFileAsync(InputFileChangeEventArgs eventArgs)
    {
        var file = eventArgs.File;
        if (file.Size > MaximumFileSizeBytes)
        {
            status = $"Could not load score: {file.Name} exceeds the 10 MiB limit.";
            return;
        }

        isLoadingScore = true;
        status = null;
        try
        {
            await using var source = file.OpenReadStream(MaximumFileSizeBytes);
            using var buffer = new MemoryStream((int)file.Size);
            await source.CopyToAsync(buffer);
            buffer.Position = 0;

            var result = await Importer.ReadAsync(buffer, file.Name);
            await ScoreLoaded.InvokeAsync(result.Score);
            status = ScoreImportStatus.Describe(result);
        }
        catch (Exception exception) when (
            exception is IOException or InvalidDataException or NotSupportedException or ArgumentException or HttpRequestException)
        {
            status = $"Could not load score: {exception.Message}";
        }
        finally
        {
            isLoadingScore = false;
        }
    }
}
