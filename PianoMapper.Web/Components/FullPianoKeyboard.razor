@implements IAsyncDisposable
@inject IJSRuntime JS

<section class="visualization-panel piano-keyboard-panel" aria-labelledby="full-piano-keyboard-heading">
    <div class="visualization-panel-header">
        <h2 id="full-piano-keyboard-heading">88-key piano</h2>
        <div class="controls">
            <span class="panel-context">A0–C8</span>
            <button class="button-quiet" type="button" @onclick="Hide">Hide</button>
        </div>
    </div>
    <p class="panel-description">
        Tap, click, or use your MIDI/computer keyboard to play. Keys light up while notes sound.
        @if (keys.Any(key => key.IsNext))
        {
            <span>Amber keys are the next notes to play.</span>
        }
    </p>
    <div class="full-piano-keyboard-scroll">
        <div class="full-piano-keyboard"
             @ref="keyboardSurface"
             role="group"
             aria-label="@KeyboardAriaLabel">
            @foreach (PianoKeyboardKey key in keys.Where(key => !key.IsBlack))
            {
                <button type="button"
                        class="@GetKeyClass(key)"
                        style="@GetKeyStyle(key)"
                        data-pitch="@key.Pitch"
                        aria-label="@key.Pitch"></button>
            }
            @foreach (PianoKeyboardKey key in keys.Where(key => key.IsBlack))
            {
                <button type="button"
                        class="@GetKeyClass(key)"
                        style="@GetKeyStyle(key)"
                        data-pitch="@key.Pitch"
                        aria-label="@key.Pitch"></button>
            }
        </div>
    </div>
</section>

@code {
    private IReadOnlyList<PianoKeyboardKey> keys = [];
    private ElementReference keyboardSurface;
    private IJSObjectReference? module;
    private DotNetObjectReference<FullPianoKeyboard>? selfReference;

    [Parameter, EditorRequired]
    public IReadOnlySet<int> ActiveMidiNumbers { get; set; } = new HashSet<int>();

    [Parameter]
    public IReadOnlySet<int> NextMidiNumbers { get; set; } = new HashSet<int>();

    [Parameter]
    public EventCallback<BrowserPointerNoteOnEvent> PointerNoteOn { get; set; }

    [Parameter]
    public EventCallback<BrowserPointerNoteOffEvent> PointerNoteOff { get; set; }

    [Parameter, EditorRequired]
    public EventCallback Hide { get; set; }

    private string KeyboardAriaLabel
    {
        get
        {
            string activeNotes = string.Join(
                ", ",
                keys.Where(key => key.IsActive).Select(key => key.Pitch.ToString()));
            string nextNotes = string.Join(
                ", ",
                keys.Where(key => key.IsNext).Select(key => key.Pitch.ToString()));
            string label = activeNotes.Length == 0
                ? "Full 88-key piano keyboard from A0 through C8. Tap or click a key to play it. No keys are sounding."
                : $"Full 88-key piano keyboard from A0 through C8. Tap or click a key to play it. Sounding: {activeNotes}.";
            return nextNotes.Length == 0 ? label : $"{label} Next to play: {nextNotes}.";
        }
    }

    protected override void OnParametersSet()
    {
        keys = FullPianoKeyboardLayout.Build(ActiveMidiNumbers, NextMidiNumbers);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/piano-keyboard-input.js");
        selfReference = DotNetObjectReference.Create(this);
        await module.InvokeVoidAsync("attach", keyboardSurface, selfReference);
    }

    [JSInvokable]
    public Task HandlePointerNoteOnAsync(BrowserPointerNoteOnEvent pointerEvent) =>
        PointerNoteOn.InvokeAsync(pointerEvent);

    [JSInvokable]
    public Task HandlePointerNoteOffAsync(BrowserPointerNoteOffEvent pointerEvent) =>
        PointerNoteOff.InvokeAsync(pointerEvent);

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            await module.InvokeVoidAsync("dispose");
            await module.DisposeAsync();
        }

        selfReference?.Dispose();
    }

    private static string GetKeyClass(PianoKeyboardKey key) =>
        $"piano-key piano-key-{(key.IsBlack ? "black" : "white")}{(key.IsActive ? " piano-key-active" : string.Empty)}{(key.IsNext ? " piano-key-next" : string.Empty)}";

    private static string GetKeyStyle(PianoKeyboardKey key) =>
        FormattableString.Invariant($"left: {key.LeftPercent:F6}%; width: {key.WidthPercent:F6}%");
}
