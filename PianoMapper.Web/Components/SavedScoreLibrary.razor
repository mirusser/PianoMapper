@inject SavedScoreClient Client
@inject IJSRuntime JS

<section class="saved-score-library" aria-labelledby="saved-scores-heading">
    <div class="saved-score-library-heading">
        <h3 id="saved-scores-heading">Saved scores</h3>
        <div class="controls">
            <button class="button-primary"
                    type="button"
                    @onclick="SaveAsync"
                    disabled="@(CurrentScore is null || isBusy)">
                @(CurrentSavedScoreId.HasValue ? "Save changes" : "Save score")
            </button>
            <button class="button-quiet" type="button" @onclick="RefreshAsync" disabled="@isBusy">Refresh</button>
        </div>
    </div>

    @if (isLoadingScore)
    {
        <ScoreLoadingIndicator />
    }

    @if (savedScores is null)
    {
        <p class="control-note">Loading saved scores…</p>
    }
    else if (savedScores.Count == 0)
    {
        <p class="control-note">No saved scores yet.</p>
    }
    else
    {
        <ul class="saved-score-list">
            @foreach (var savedScore in savedScores)
            {
                <li>
                    <span>
                        <strong>@savedScore.Title</strong>
                        <small>
                            @savedScore.MeasureCount measure(s) · saved
                            @savedScore.UpdatedAt.ToLocalTime().ToString("g", CultureInfo.CurrentCulture)
                        </small>
                    </span>
                    <div class="saved-score-actions">
                        <button type="button"
                                @onclick="() => LoadAsync(savedScore.Id)"
                                disabled="@isBusy"
                                aria-label="Load @savedScore.Title">
                            Load
                        </button>
                        <button class="button-danger"
                                type="button"
                                @onclick="() => DeleteAsync(savedScore)"
                                disabled="@isBusy"
                                aria-label="Delete @savedScore.Title">
                            Delete
                        </button>
                    </div>
                </li>
            }
        </ul>
    }

    @if (!string.IsNullOrEmpty(status))
    {
        <p class="control-note" role="status">@status</p>
    }
</section>

@code {
    private IReadOnlyList<SavedScoreSummary>? savedScores;
    private string? status;
    private bool isBusy;
    private bool isLoadingScore;

    [Parameter]
    public Score? CurrentScore { get; set; }

    [Parameter]
    public Guid? CurrentSavedScoreId { get; set; }

    [Parameter]
    public EventCallback<SavedScoreDetails> ScoreLoaded { get; set; }

    [Parameter]
    public EventCallback<SavedScoreDetails> ScoreSaved { get; set; }

    [Parameter]
    public EventCallback<Guid> ScoreDeleted { get; set; }

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        isBusy = true;
        try
        {
            savedScores = await Client.ListAsync();
            status = null;
        }
        catch (HttpRequestException exception) when (exception.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            savedScores = [];
            status = "Saved scores require the hosted PianoMapper server.";
        }
        catch (Exception exception) when (
            exception is HttpRequestException or JsonException or NotSupportedException)
        {
            savedScores = [];
            status = $"Could not load saved scores: {exception.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SaveAsync()
    {
        if (CurrentScore is null)
        {
            return;
        }

        isBusy = true;
        try
        {
            SavedScoreDetails savedScore = CurrentSavedScoreId is Guid id
                ? await Client.UpdateAsync(id, CurrentScore)
                : await Client.CreateAsync(CurrentScore);
            AddOrReplaceSummary(savedScore);
            await ScoreSaved.InvokeAsync(savedScore);
            status = $"Saved {savedScore.Score.Title}.";
        }
        catch (Exception exception) when (
            exception is HttpRequestException or InvalidDataException or JsonException or NotSupportedException)
        {
            status = $"Could not save score: {exception.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LoadAsync(Guid id)
    {
        isBusy = true;
        isLoadingScore = true;
        status = null;
        try
        {
            SavedScoreDetails savedScore = await Client.FindAsync(id);
            await ScoreLoaded.InvokeAsync(savedScore);
            status = $"Loaded {savedScore.Score.Title} from saved scores.";
        }
        catch (Exception exception) when (
            exception is HttpRequestException or InvalidDataException or JsonException or NotSupportedException)
        {
            status = $"Could not load saved score: {exception.Message}";
        }
        finally
        {
            isBusy = false;
            isLoadingScore = false;
        }
    }

    private async Task DeleteAsync(SavedScoreSummary savedScore)
    {
        bool confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete {savedScore.Title} from saved scores? This cannot be undone.");
        if (!confirmed)
        {
            return;
        }

        isBusy = true;
        status = null;
        bool wasCurrentScore = CurrentSavedScoreId == savedScore.Id;
        try
        {
            await Client.DeleteAsync(savedScore.Id);
            savedScores = (savedScores ?? [])
                .Where(score => score.Id != savedScore.Id)
                .ToArray();
            await ScoreDeleted.InvokeAsync(savedScore.Id);
            status = wasCurrentScore
                ? $"Deleted {savedScore.Title} from saved scores. The score remains open until you unload or replace it."
                : $"Deleted {savedScore.Title} from saved scores.";
        }
        catch (Exception exception) when (
            exception is HttpRequestException or NotSupportedException)
        {
            status = $"Could not delete saved score: {exception.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void AddOrReplaceSummary(SavedScoreDetails savedScore)
    {
        var summary = new SavedScoreSummary(
            savedScore.Id,
            savedScore.Score.Title,
            savedScore.Score.Measures.Count,
            savedScore.CreatedAt,
            savedScore.UpdatedAt);
        savedScores = [summary, .. (savedScores ?? []).Where(score => score.Id != summary.Id)];
    }
}
