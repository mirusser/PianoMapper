<details class="control-card settings-card" aria-labelledby="sight-reading-heading" open="@IsActive">
    <summary class="control-card-heading">
        <h2 id="sight-reading-heading">Note reading exercise</h2>
        <span>Self-paced pitch practice</span>
    </summary>
    <div class="controls">
        <label class="octave-picker">
            Staff
            <select value="@SelectedStaff" @onchange="SelectStaffAsync" disabled="@IsGrandStaff">
                <option value="@Staff.Treble">Treble / right hand</option>
                <option value="@Staff.Bass">Bass / left hand</option>
            </select>
        </label>
        <label class="control-checkbox">
            <input type="checkbox" checked="@IsGrandStaff" @onchange="SelectIsGrandStaffAsync" />
            Grand staff (alternate both hands)
        </label>
        <label class="octave-picker">
            Range
            <select value="@PresetId" @onchange="SelectPresetIdAsync">
                <option value="@SightReadingPresetId.FiveNote">Starter — five notes</option>
                <option value="@SightReadingPresetId.OneOctave">One octave</option>
                <option value="@SightReadingPresetId.LedgerLines">Ledger lines</option>
                <option value="@SightReadingPresetId.GMajor">G major (one sharp)</option>
                <option value="@SightReadingPresetId.FMajor">F major (one flat)</option>
                <option value="@SightReadingPresetId.Chords">Chords (I, IV, V)</option>
            </select>
        </label>
        <label class="octave-picker">
            Length
            <select value="@PromptCountOption" @onchange="SelectPromptCountOptionAsync">
                <option value="8">8 notes</option>
                <option value="16">16 notes</option>
            </select>
        </label>
        <label class="octave-picker">
            Rhythm
            <select value="@RhythmPreset" @onchange="SelectRhythmPresetAsync">
                <option value="@SightReadingRhythmPreset.Fixed">Fixed quarter notes</option>
                <option value="@SightReadingRhythmPreset.Basic">Basic (4/4 half/quarter/eighths)</option>
                <option value="@SightReadingRhythmPreset.Compound">Compound (6/8)</option>
            </select>
        </label>
        <label class="octave-picker">
            Mode
            <select value="@Mode" @onchange="SelectModeAsync">
                <option value="@NoteReadingMode.PitchAndOrder">Pitch only (self-paced)</option>
                <option value="@NoteReadingMode.PitchAndHold">Pitch + hold (written duration)</option>
                <option value="@NoteReadingMode.PitchHoldAndRhythm">Rhythm (timed, with count-in)</option>
            </select>
        </label>
        <label class="control-checkbox">
            <input type="checkbox"
                   checked="@RevealNoteNamesWhileActive"
                   @onchange="SelectRevealNoteNamesWhileActiveAsync" />
            Show note names while playing
        </label>
        <label class="control-checkbox">
            <input type="checkbox"
                   checked="@RevealFingeringWhileActive"
                   @onchange="SelectRevealFingeringWhileActiveAsync" />
            Show fingering while playing
        </label>
        <button class="button-primary" type="button" @onclick="Generate">
            @(IsComplete ? "Next exercise" : "Generate new exercise")
        </button>
        <button type="button" @onclick="Retry" disabled="@(!IsActive)">
            Retry same notes
        </button>
        <button type="button" @onclick="RetryMissed" disabled="@(!HasMissedPrompts)">
            Retry missed notes
        </button>
        <button class="button-quiet" type="button" @onclick="End" disabled="@(!IsActive)">
            End exercise
        </button>
    </div>
    <p class="control-note" role="status">
        @InputReadinessMessage
        @HiddenAnswersMessage
    </p>
    @if (!IsMidiInputConnected)
    {
        <button type="button" @onclick="ConnectMidi" disabled="@IsMidiConnecting">
            @(IsMidiConnecting ? "Connecting MIDI piano…" : "Connect MIDI piano")
        </button>
    }
    @if (IsActive)
    {
        <p role="status">
            @if (IsComplete)
            {
                <span>
                    Complete: @FirstTryCorrectCount of @CompletedPromptCount first-try correct
                    (@FirstTryAccuracyPercent.ToString("F1", CultureInfo.InvariantCulture)%),
                    @WrongAttemptCount mistake(s), @ElapsedTime.ToString(@"m\:ss", CultureInfo.InvariantCulture) elapsed.
                </span>
            }
            else
            {
                <span>
                    Progress: @CompletedPromptCount of @PromptCount notes ·
                    @FirstTryAccuracyPercent.ToString("F1", CultureInfo.InvariantCulture)% first-try accuracy ·
                    @WrongAttemptCount mistake(s)
                </span>
            }
        </p>
    }
</details>

@code {
    [Parameter]
    public Staff SelectedStaff { get; set; }

    [Parameter]
    public SightReadingPresetId PresetId { get; set; }

    [Parameter]
    public int PromptCountOption { get; set; }

    [Parameter]
    public bool IsGrandStaff { get; set; }

    [Parameter]
    public SightReadingRhythmPreset RhythmPreset { get; set; }

    [Parameter]
    public NoteReadingMode Mode { get; set; }

    [Parameter]
    public bool RevealNoteNamesWhileActive { get; set; }

    [Parameter]
    public bool RevealFingeringWhileActive { get; set; }

    [Parameter]
    public bool IsActive { get; set; }

    [Parameter]
    public bool IsComplete { get; set; }

    [Parameter]
    public bool HasMissedPrompts { get; set; }

    [Parameter]
    public bool IsMidiInputConnected { get; set; }

    [Parameter]
    public bool IsMidiConnecting { get; set; }

    [Parameter]
    public bool IsComputerPianoEnabled { get; set; }

    [Parameter]
    public EventCallback ConnectMidi { get; set; }

    [Parameter]
    public int PromptCount { get; set; }

    [Parameter]
    public int CompletedPromptCount { get; set; }

    [Parameter]
    public int FirstTryCorrectCount { get; set; }

    [Parameter]
    public int WrongAttemptCount { get; set; }

    [Parameter]
    public double FirstTryAccuracyPercent { get; set; }

    [Parameter]
    public TimeSpan ElapsedTime { get; set; }

    [Parameter]
    public EventCallback<Staff> SelectedStaffChanged { get; set; }

    [Parameter]
    public EventCallback<SightReadingPresetId> PresetIdChanged { get; set; }

    [Parameter]
    public EventCallback<int> PromptCountOptionChanged { get; set; }

    [Parameter]
    public EventCallback<bool> IsGrandStaffChanged { get; set; }

    [Parameter]
    public EventCallback<SightReadingRhythmPreset> RhythmPresetChanged { get; set; }

    [Parameter]
    public EventCallback<NoteReadingMode> ModeChanged { get; set; }

    [Parameter]
    public EventCallback<bool> RevealNoteNamesWhileActiveChanged { get; set; }

    [Parameter]
    public EventCallback<bool> RevealFingeringWhileActiveChanged { get; set; }

    [Parameter]
    public EventCallback Generate { get; set; }

    [Parameter]
    public EventCallback Retry { get; set; }

    [Parameter]
    public EventCallback RetryMissed { get; set; }

    [Parameter]
    public EventCallback End { get; set; }

    // Always names the on-screen 88-key piano as a fallback, regardless of MIDI connection state, so this never
    // reads as "you must have MIDI" — MIDI is simply the first-listed, not required, input method.
    private string InputReadinessMessage
    {
        get
        {
            string fallback = IsComputerPianoEnabled
                ? "the on-screen piano below or your computer keyboard"
                : "the on-screen piano below";

            return IsMidiInputConnected
                ? $"MIDI piano connected — play each highlighted note on it, or on {fallback}."
                : $"No MIDI piano connected — play each highlighted note on {fallback}.";
        }
    }

    private string HiddenAnswersMessage
    {
        get
        {
            if (RevealNoteNamesWhileActive && RevealFingeringWhileActive)
            {
                return "Note names and fingerings stay visible the whole time, based on the options above.";
            }

            if (RevealNoteNamesWhileActive)
            {
                return "Note names stay visible the whole time; fingerings stay hidden until review, based on " +
                    "the options above.";
            }

            if (RevealFingeringWhileActive)
            {
                return "Fingerings stay visible the whole time; note names stay hidden until review, based on " +
                    "the options above.";
            }

            return "Note names and fingerings stay hidden while the exercise is active and are revealed for " +
                "review once you complete it.";
        }
    }

    private Task SelectStaffAsync(ChangeEventArgs eventArgs) =>
        Enum.TryParse(eventArgs.Value?.ToString(), out Staff staff) && Enum.IsDefined(staff)
            ? SelectedStaffChanged.InvokeAsync(staff)
            : Task.CompletedTask;

    private Task SelectPresetIdAsync(ChangeEventArgs eventArgs) =>
        Enum.TryParse(eventArgs.Value?.ToString(), out SightReadingPresetId presetId) && Enum.IsDefined(presetId)
            ? PresetIdChanged.InvokeAsync(presetId)
            : Task.CompletedTask;

    private Task SelectPromptCountOptionAsync(ChangeEventArgs eventArgs) =>
        int.TryParse(eventArgs.Value?.ToString(), CultureInfo.InvariantCulture, out int promptCount) &&
        promptCount is 8 or 16
            ? PromptCountOptionChanged.InvokeAsync(promptCount)
            : Task.CompletedTask;

    private Task SelectIsGrandStaffAsync(ChangeEventArgs eventArgs) =>
        IsGrandStaffChanged.InvokeAsync(eventArgs.Value is true);

    private Task SelectRhythmPresetAsync(ChangeEventArgs eventArgs) =>
        Enum.TryParse(eventArgs.Value?.ToString(), out SightReadingRhythmPreset rhythmPreset) &&
        Enum.IsDefined(rhythmPreset)
            ? RhythmPresetChanged.InvokeAsync(rhythmPreset)
            : Task.CompletedTask;

    private Task SelectModeAsync(ChangeEventArgs eventArgs) =>
        Enum.TryParse(eventArgs.Value?.ToString(), out NoteReadingMode mode) && Enum.IsDefined(mode)
            ? ModeChanged.InvokeAsync(mode)
            : Task.CompletedTask;

    private Task SelectRevealNoteNamesWhileActiveAsync(ChangeEventArgs eventArgs) =>
        RevealNoteNamesWhileActiveChanged.InvokeAsync(eventArgs.Value is true);

    private Task SelectRevealFingeringWhileActiveAsync(ChangeEventArgs eventArgs) =>
        RevealFingeringWhileActiveChanged.InvokeAsync(eventArgs.Value is true);
}
