<section class="control-card" aria-labelledby="sight-reading-heading">
    <div class="control-card-heading">
        <h2 id="sight-reading-heading">Note reading exercise</h2>
        <div class="controls">
            <span>Pitch and rhythm practice</span>
            <button class="button-quiet" type="button" @onclick="Hide">Hide</button>
        </div>
    </div>
    <div class="control-column exercise-layout">
        <div class="control-sections exercise-settings">
            <div role="group" aria-labelledby="sight-reading-setup-heading">
                <span class="control-group-label" id="sight-reading-setup-heading">Setup</span>
                <div class="control-grid">
                    <label class="timing-field">
                        <span>Staff</span>
                        <select value="@Presentation.SelectedStaff" @onchange="SelectStaffAsync" disabled="@(Presentation.IsGrandStaff && !Presentation.IsPitchSetupIgnored)">
                            <option value="@Staff.Treble">Treble / right hand</option>
                            <option value="@Staff.Bass">Bass / left hand</option>
                        </select>
                    </label>
                    <label class="control-checkbox">
                        <input type="checkbox"
                               checked="@(Presentation.IsGrandStaff && !Presentation.IsPitchSetupIgnored)"
                               disabled="@Presentation.IsPitchSetupIgnored"
                               @onchange="SelectIsGrandStaffAsync" />
                        Grand staff (both hands)
                    </label>
                    <label class="control-checkbox">
                        <input type="checkbox"
                               checked="@Presentation.IsHandsTogether"
                               disabled="@(!Presentation.IsHandsTogetherAvailable)"
                               @onchange="SelectHandsTogetherAsync" />
                        Hands together
                    </label>
                    <label class="timing-field">
                        <span>Range</span>
                        <select value="@Presentation.PresetId" @onchange="SelectPresetIdAsync" disabled="@Presentation.IsPitchSetupIgnored">
                            @foreach (SightReadingPresetId presetOption in Enum.GetValues<SightReadingPresetId>())
                            {
                                <option value="@presetOption">@SightReadingLabels.PresetOption(presetOption)</option>
                            }
                        </select>
                    </label>
                    <label class="timing-field">
                        <span>Pattern</span>
                        <select value="@Presentation.Motion" @onchange="SelectMotionAsync" disabled="@(!Presentation.IsMotionAvailable)">
                            @foreach (SightReadingMotion motionOption in Enum.GetValues<SightReadingMotion>())
                            {
                                <option value="@motionOption">@SightReadingLabels.MotionOption(motionOption)</option>
                            }
                        </select>
                    </label>
                    @if (Presentation.Motion == SightReadingMotion.Intervallic)
                    {
                        <label class="timing-field">
                            <span>Interval</span>
                            <select value="@Presentation.IntervalSteps" @onchange="SelectIntervalStepsAsync">
                                @for (int steps = SightReadingExerciseOptions.MinimumIntervalSteps; steps <= SightReadingExerciseOptions.MaximumIntervalSteps; steps++)
                                {
                                    <option value="@steps">@SightReadingLabels.IntervalSize(steps)</option>
                                }
                            </select>
                        </label>
                    }
                    <label class="timing-field">
                        <span>Length</span>
                        <select value="@Presentation.PromptCountOption" @onchange="SelectPromptCountOptionAsync">
                            @foreach (int promptCountChoice in SightReadingLabels.PromptCountChoices)
                            {
                                <option value="@promptCountChoice">@SightReadingLabels.PromptCountOption(promptCountChoice)</option>
                            }
                        </select>
                    </label>
                    <label class="timing-field">
                        <span>Rhythm</span>
                        <select value="@Presentation.RhythmPreset" @onchange="SelectRhythmPresetAsync" disabled="@Presentation.IsRhythmPresetLocked">
                            @foreach (SightReadingRhythmPreset rhythmOption in Enum.GetValues<SightReadingRhythmPreset>())
                            {
                                <option value="@rhythmOption">@SightReadingLabels.RhythmPresetOption(rhythmOption)</option>
                            }
                        </select>
                    </label>
                    <label class="timing-field">
                        <span>Mode</span>
                        <select value="@Presentation.Mode" @onchange="SelectModeAsync">
                            @foreach (NoteReadingMode modeOption in SightReadingLabels.LadderModes)
                            {
                                <option value="@modeOption">@SightReadingLabels.ModeOption(modeOption)</option>
                            }
                        </select>
                    </label>
                    <label class="timing-field">
                        <span>Pacing</span>
                        <select value="@Presentation.Pacing" @onchange="SelectPacingAsync" disabled="@(!Presentation.IsPacingAvailable)">
                            @foreach (ExercisePacing pacingOption in Enum.GetValues<ExercisePacing>())
                            {
                                <option value="@pacingOption">@SightReadingLabels.PacingOption(pacingOption)</option>
                            }
                        </select>
                    </label>
                    @if (SightReadingLabels.IsTimingGraded(Presentation.Mode))
                    {
                        <label class="timing-field">
                            <span>Tempo (@SightReadingLabels.TempoUnit(Presentation.RhythmPreset) per minute)</span>
                            <input type="number"
                                   min="@SightReadingExerciseOptions.MinimumTempoPulsesPerMinute"
                                   max="@SightReadingExerciseOptions.MaximumTempoPulsesPerMinute"
                                   step="1"
                                   value="@Presentation.TempoPulsesPerMinute"
                                   @onchange="SelectTempoAsync" />
                        </label>
                    }
                </div>
            <p class="control-note" role="status">
                @if (Enum.IsDefined(Presentation.Mode) && Presentation.Mode != NoteReadingMode.Off)
                {
                    <span>@SightReadingLabels.ModeDescription(Presentation.Mode)</span>
                }
                @if (Presentation.IsPitchSetupIgnored)
                {
                    <span> Range, pattern and grand staff do not apply: this mode repeats one note on the middle line of the staff.</span>
                }
                else if (!Presentation.IsMotionAvailable)
                {
                    <span> Chord and accidental exercises pick their own notes, so the pattern does not apply.</span>
                }
                @if (Presentation.IsGrandStaff && !Presentation.IsHandsTogetherAvailable && !Presentation.IsPitchSetupIgnored)
                {
                    <span> Hands together plays both hands at once and needs the five-note range.</span>
                }
                @if (Presentation.IsRhythmPresetLocked)
                {
                    <span> Grand staff and chord exercises use fixed quarter notes; variable rhythms need single notes on one staff.</span>
                }
                @if (!Presentation.IsPacingAvailable)
                {
                    <span> Play along follows a beat, so this mode always waits for you.</span>
                }
                else if (Presentation.Pacing == ExercisePacing.PlayAlong)
                {
                    <span> The cursor keeps moving whether or not you play; skipped notes are marked missed.</span>
                }
            </p>
            </div>
            <div class="exercise-settings-secondary">
                <div role="group" aria-labelledby="sight-reading-reveal-heading">
                    <span class="control-group-label" id="sight-reading-reveal-heading">While playing</span>
                    <div class="control-grid control-grid-tiles exercise-playing-options">
                        <label class="control-checkbox">
                            <input type="checkbox"
                                   checked="@Presentation.RevealNoteNamesWhileActive"
                                   @onchange="SelectRevealNoteNamesWhileActiveAsync" />
                            Show note names
                        </label>
                        <label class="control-checkbox">
                            <input type="checkbox"
                                   checked="@Presentation.RevealFingeringWhileActive"
                                   @onchange="SelectRevealFingeringWhileActiveAsync" />
                            Show fingering
                        </label>
                        <label class="control-checkbox">
                            <input type="checkbox"
                                   checked="@Presentation.RevealKeysWhileActive"
                                   @onchange="SelectRevealKeysWhileActiveAsync" />
                            Highlight next keys on the piano
                        </label>
                        <label class="control-checkbox">
                            <input type="checkbox"
                                   checked="@Presentation.CoachHints"
                                   disabled="@(Presentation.Pacing == ExercisePacing.PlayAlong)"
                                   @onchange="SelectCoachHintsAsync" />
                            Coach hints
                        </label>
                        @if (SightReadingLabels.IsTimingGraded(Presentation.Mode))
                        {
                            <label class="control-checkbox">
                                <input type="checkbox"
                                       checked="@Presentation.ClickWhilePlaying"
                                       disabled="@(!Presentation.CanChangeClickWhilePlaying)"
                                       @onchange="SelectClickWhilePlayingAsync" />
                                Keep the click going while playing
                            </label>
                        }
                    </div>
                </div>
                <div role="group" aria-labelledby="sight-reading-finish-heading">
                    <span class="control-group-label" id="sight-reading-finish-heading">When finished</span>
                    <div class="control-grid control-grid-tiles">
                        <label class="control-checkbox">
                            <input type="checkbox"
                                   checked="@Presentation.AutoNext"
                                   @onchange="SelectAutoNextAsync" />
                            Start the next exercise automatically after @AutoNextSeconds seconds
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="exercise-actions" role="group" aria-label="Exercise session controls">
            <button class="button-primary" type="button" @onclick="GenerateAsync">
                @(Presentation.IsComplete ? "Next exercise" : "Generate new exercise")
            </button>
            <button type="button"
                    @onclick="StartRecommendedAsync"
                    title="@Presentation.RecommendedExerciseDescription">
                Start recommended exercise
            </button>
            <button type="button" @onclick="RetryAsync" disabled="@(!Presentation.IsActive)">
                Retry same notes
            </button>
            <button type="button" @onclick="RetryMissedAsync" disabled="@(!Presentation.HasMissedPrompts)">
                Retry missed notes
            </button>
            <button type="button"
                    @onclick="DrillWeakNotesAsync"
                    disabled="@(!Presentation.CanDrillWeakNotes)"
                    title="@(Presentation.CanDrillWeakNotes ? "Practice the notes you miss most in this range" : Presentation.DrillUnavailableReason)">
                Drill my weak notes
            </button>
            <button class="button-quiet" type="button" @onclick="EndAsync" disabled="@(!Presentation.IsActive)">
                End exercise
            </button>
        </div>
        <p class="control-note">@Presentation.RecommendedExerciseDescription</p>
        @if (!Presentation.CanDrillWeakNotes && !string.IsNullOrEmpty(Presentation.DrillUnavailableReason))
        {
            <p class="control-note">Drill my weak notes: @Presentation.DrillUnavailableReason</p>
        }
        @if (Presentation.IsClickRunning)
        {
            <TempoFeedback Feedback="Presentation.TempoFeedback" />
        }
        @if (Presentation.IsActive)
        {
            <section class="exercise-progress" aria-label="Exercise progress">
                <p class="exercise-progress-summary" role="status">
                @if (Presentation.IsComplete)
                {
                    <span>
                        Complete: @Presentation.FirstTryCorrectCount of @Presentation.CompletedPromptCount first-try correct
                        (@Presentation.FirstTryAccuracyPercent.ToString("F1", CultureInfo.InvariantCulture)%),
                        @Presentation.WrongAttemptCount mistake(s), @Presentation.ElapsedTime.ToString(@"m\:ss", CultureInfo.InvariantCulture) elapsed.
                        @if (ShowsTimingBreakdown)
                        {
                            <text> (@TimingBreakdown)</text>
                        }
                        @if (Presentation.PlayAlongVerdictCounts is not null)
                        {
                            <text> Run: @SightReadingLabels.DescribeVerdictCounts(Presentation.PlayAlongVerdictCounts).</text>
                        }
                    </span>
                }
                else
                {
                    <span>
                        Progress: @Presentation.CompletedPromptCount of @Presentation.PromptCount notes ·
                        @Presentation.FirstTryAccuracyPercent.ToString("F1", CultureInfo.InvariantCulture)% first-try accuracy ·
                        @Presentation.WrongAttemptCount mistake(s)
                        @if (ShowsTimingBreakdown)
                        {
                            <text> · @TimingBreakdown</text>
                        }
                    </span>
                }
                </p>
                @if (Presentation.ReviewMistakes is { Lines.Count: > 0 } reviewMistakes)
                {
                    <div class="exercise-progress-review" aria-labelledby="exercise-review-heading">
                        <h3 id="exercise-review-heading">Mistakes to look at</h3>
                        <ul class="exercise-review-list">
                            @foreach (ExerciseReviewLine reviewLine in reviewMistakes.Lines)
                            {
                                <li>@ExerciseReviewBuilder.Describe(reviewLine)</li>
                            }
                        </ul>
                        @if (reviewMistakes.MoreCount > 0)
                        {
                            <p class="control-note">and @reviewMistakes.MoreCount more</p>
                        }
                    </div>
                }
            </section>
        }
        @if (Presentation.AutoNextSecondsRemaining is not null)
        {
            <p class="exercise-inline-actions">
                <span>The countdown is shown on the grand staff.</span>
                <button class="button-quiet" type="button" @onclick="CancelAutoNextAsync">Stay here</button>
            </p>
        }
        @if (Presentation.IsComplete && Presentation.ScorePageCount > MeasureRowsOnScreen)
        {
            <div class="exercise-inline-actions" role="group" aria-label="Review the exercise page by page">
                <button type="button" @onclick="ShowPreviousMeasuresAsync" disabled="@(!Presentation.CanShowPreviousMeasures)">
                    Previous measures <kbd>[</kbd>
                </button>
                <button type="button" @onclick="ShowNextMeasuresAsync" disabled="@(!Presentation.CanShowNextMeasures)">
                    Next measures <kbd>]</kbd>
                </button>
            </div>
        }
        <p class="control-note" role="status">
            @InputReadinessMessage
            @HiddenAnswersMessage
        </p>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public SightReadingExercisePresentation Presentation { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventCallback<SightReadingExerciseAction> OnAction { get; set; }

    [Parameter, EditorRequired]
    public EventCallback Hide { get; set; }

    private bool ShowsTimingBreakdown =>
        SightReadingLabels.IsTimingGraded(Presentation.RunMode) && Presentation.CompletedPromptCount > 0;

    private string TimingBreakdown => SightReadingLabels.DescribeTimingBreakdown(
        Presentation.PitchFirstTryCorrectCount,
        Presentation.CompletedPromptCount,
        Presentation.TimingMistakeCount);

    // Always names the on-screen 88-key piano as a fallback, regardless of MIDI connection state, so this never
    // reads as "you must have MIDI" — MIDI is simply the first-listed, not required, input method.
    private string InputReadinessMessage
    {
        get
        {
            string fallback = Presentation.IsComputerPianoEnabled
                ? "the on-screen piano below or your computer keyboard"
                : "the on-screen piano below";

            return Presentation.IsMidiInputConnected
                ? $"MIDI piano connected — play each highlighted note on it, or on {fallback}."
                : $"No MIDI piano connected — play each highlighted note on {fallback}.";
        }
    }

    private string HiddenAnswersMessage => Presentation.RevealKeysWhileActive
        ? $"{NamesAndFingeringsMessage} The next keys on the piano stay highlighted."
        : NamesAndFingeringsMessage;

    private string NamesAndFingeringsMessage
    {
        get
        {
            if (Presentation.RevealNoteNamesWhileActive && Presentation.RevealFingeringWhileActive)
            {
                return "Note names and fingerings stay visible the whole time, based on the options above.";
            }

            if (Presentation.RevealNoteNamesWhileActive)
            {
                return "Note names stay visible the whole time; fingerings stay hidden until review, based on " +
                    "the options above.";
            }

            if (Presentation.RevealFingeringWhileActive)
            {
                return "Fingerings stay visible the whole time; note names stay hidden until review, based on " +
                    "the options above.";
            }

            return "Note names and fingerings stay hidden while the exercise is active and are revealed for " +
                "review once you complete it.";
        }
    }

    private Task SelectStaffAsync(ChangeEventArgs eventArgs) =>
        Enum.TryParse(eventArgs.Value?.ToString(), out Staff staff) && Enum.IsDefined(staff)
            ? OnAction.InvokeAsync(new SightReadingExerciseAction.SelectStaff(staff))
            : Task.CompletedTask;

    private Task SelectPresetIdAsync(ChangeEventArgs eventArgs) =>
        Enum.TryParse(eventArgs.Value?.ToString(), out SightReadingPresetId presetId) && Enum.IsDefined(presetId)
            ? OnAction.InvokeAsync(new SightReadingExerciseAction.SelectPreset(presetId))
            : Task.CompletedTask;

    // The score draws two rows of measure pages, so an exercise of up to two pages is always fully on screen.
    private const int MeasureRowsOnScreen = 2;

    private static int AutoNextSeconds => (int)SightReadingExerciseCoordinator.AutoNextDelay.TotalSeconds;

    private Task SelectPromptCountOptionAsync(ChangeEventArgs eventArgs) =>
        int.TryParse(eventArgs.Value?.ToString(), CultureInfo.InvariantCulture, out int promptCount) &&
        SightReadingLabels.PromptCountChoices.Contains(promptCount)
            ? OnAction.InvokeAsync(new SightReadingExerciseAction.SelectPromptCount(promptCount))
            : Task.CompletedTask;

    private Task SelectMotionAsync(ChangeEventArgs eventArgs) =>
        Enum.TryParse(eventArgs.Value?.ToString(), out SightReadingMotion motion) && Enum.IsDefined(motion)
            ? OnAction.InvokeAsync(new SightReadingExerciseAction.SelectMotion(motion))
            : Task.CompletedTask;

    private Task SelectIntervalStepsAsync(ChangeEventArgs eventArgs) =>
        int.TryParse(eventArgs.Value?.ToString(), CultureInfo.InvariantCulture, out int steps) &&
        steps is >= SightReadingExerciseOptions.MinimumIntervalSteps and <= SightReadingExerciseOptions.MaximumIntervalSteps
            ? OnAction.InvokeAsync(new SightReadingExerciseAction.SelectIntervalSteps(steps))
            : Task.CompletedTask;

    private Task SelectIsGrandStaffAsync(ChangeEventArgs eventArgs) =>
        OnAction.InvokeAsync(new SightReadingExerciseAction.SelectGrandStaff(eventArgs.Value is true));

    private Task SelectHandsTogetherAsync(ChangeEventArgs eventArgs) =>
        OnAction.InvokeAsync(new SightReadingExerciseAction.SetHandsTogether(eventArgs.Value is true));

    private Task SelectRhythmPresetAsync(ChangeEventArgs eventArgs) =>
        Enum.TryParse(eventArgs.Value?.ToString(), out SightReadingRhythmPreset rhythmPreset) &&
        Enum.IsDefined(rhythmPreset)
            ? OnAction.InvokeAsync(new SightReadingExerciseAction.SelectRhythmPreset(rhythmPreset))
            : Task.CompletedTask;

    private Task SelectModeAsync(ChangeEventArgs eventArgs) =>
        Enum.TryParse(eventArgs.Value?.ToString(), out NoteReadingMode mode) && Enum.IsDefined(mode)
            ? OnAction.InvokeAsync(new SightReadingExerciseAction.SelectMode(mode))
            : Task.CompletedTask;

    private Task SelectPacingAsync(ChangeEventArgs eventArgs) =>
        Enum.TryParse(eventArgs.Value?.ToString(), out ExercisePacing pacing) && Enum.IsDefined(pacing)
            ? OnAction.InvokeAsync(new SightReadingExerciseAction.SelectPacing(pacing))
            : Task.CompletedTask;

    private Task SelectTempoAsync(ChangeEventArgs eventArgs) =>
        int.TryParse(eventArgs.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int pulses) &&
        pulses is >= SightReadingExerciseOptions.MinimumTempoPulsesPerMinute
            and <= SightReadingExerciseOptions.MaximumTempoPulsesPerMinute
            ? OnAction.InvokeAsync(new SightReadingExerciseAction.SelectTempo(pulses))
            : Task.CompletedTask;

    private Task SelectRevealNoteNamesWhileActiveAsync(ChangeEventArgs eventArgs) =>
        OnAction.InvokeAsync(new SightReadingExerciseAction.SetRevealNoteNames(eventArgs.Value is true));

    private Task SelectRevealFingeringWhileActiveAsync(ChangeEventArgs eventArgs) =>
        OnAction.InvokeAsync(new SightReadingExerciseAction.SetRevealFingering(eventArgs.Value is true));

    private Task SelectRevealKeysWhileActiveAsync(ChangeEventArgs eventArgs) =>
        OnAction.InvokeAsync(new SightReadingExerciseAction.SetRevealKeys(eventArgs.Value is true));

    private Task SelectCoachHintsAsync(ChangeEventArgs eventArgs) =>
        OnAction.InvokeAsync(new SightReadingExerciseAction.SetCoachHints(eventArgs.Value is true));

    private Task SelectClickWhilePlayingAsync(ChangeEventArgs eventArgs) =>
        OnAction.InvokeAsync(new SightReadingExerciseAction.SetClickWhilePlaying(eventArgs.Value is true));

    private Task SelectAutoNextAsync(ChangeEventArgs eventArgs) =>
        OnAction.InvokeAsync(new SightReadingExerciseAction.SetAutoNext(eventArgs.Value is true));

    private Task CancelAutoNextAsync() => OnAction.InvokeAsync(new SightReadingExerciseAction.CancelAutoNext());

    private Task ShowPreviousMeasuresAsync() => OnAction.InvokeAsync(new SightReadingExerciseAction.ShowPreviousMeasures());

    private Task ShowNextMeasuresAsync() => OnAction.InvokeAsync(new SightReadingExerciseAction.ShowNextMeasures());

    private Task GenerateAsync() => OnAction.InvokeAsync(new SightReadingExerciseAction.Generate());

    private Task StartRecommendedAsync() => OnAction.InvokeAsync(new SightReadingExerciseAction.StartRecommended());

    private Task DrillWeakNotesAsync() => OnAction.InvokeAsync(new SightReadingExerciseAction.DrillWeakNotes());

    private Task RetryAsync() => OnAction.InvokeAsync(new SightReadingExerciseAction.Retry());

    private Task RetryMissedAsync() => OnAction.InvokeAsync(new SightReadingExerciseAction.RetryMissed());

    private Task EndAsync() => OnAction.InvokeAsync(new SightReadingExerciseAction.End());
}
