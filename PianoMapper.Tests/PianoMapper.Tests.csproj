<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.7.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>

    <!-- ImageSharp reaches this project through PianoMapper.Server; see the justification there. -->
    <ItemGroup>
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PianoMapper.Core\PianoMapper.Core.csproj" />
        <ProjectReference Include="..\PianoMapper\PianoMapper.csproj" />
        <ProjectReference Include="..\PianoMapper.Web\PianoMapper.Web.csproj" />
        <ProjectReference Include="..\PianoMapper.Server\PianoMapper.Server.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Fixtures\*.musicxml" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Fixtures\w3c\*.musicxml" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="Fixtures\w3c\README.md" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\mia_sebastians_theme_ivanovskaya_transcription.musicxml"
                 Link="Fixtures\mia_sebastians_theme_ivanovskaya_transcription.musicxml"
                 CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
