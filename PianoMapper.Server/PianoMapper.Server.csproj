<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.9" />
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    </ItemGroup>

    <!--
        SixLabors.ImageSharp 2.1.13 has open advisories that only 4.1.2 fixes, and 4.x fails Release builds
        without a Six Labors licence key, so we stay on 2.1.13 and keep the affected code unreachable:
        - TIFF decode/encode (GHSA-wmxv-xphr-5c9g, GHSA-j9gm-c75j-xc9q, GHSA-jjfr-hcj7-qf5w): ScoreImagePreprocessor
          registers only the PNG and JPEG decoders and the app only ever saves PNG.
        - HistogramEqualization (GHSA-j3p4-wp97-rph4): never called.
        - ICC CLUT parsing (GHSA-gwg2-r3hj-4w44): a JPEG's profile is kept but never parsed, and the 2.1.13 PNG
          decoder ignores iCCP; checked with a hostile profile (parsing it directly allocates 130 MB or more,
          the decode and PNG re-encode path allocates under 1 MB).
        Re-check this list before widening the accepted formats or touching image metadata, and drop the
        entries once ImageSharp is upgraded.
    -->
    <ItemGroup>
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PianoMapper.Core\PianoMapper.Core.csproj" />
        <ProjectReference Include="..\PianoMapper.Web\PianoMapper.Web.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PianoMapper.Tests" />
    </ItemGroup>

</Project>
